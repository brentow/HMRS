<UserControl x:Class="HRMS.View.RecruitmentWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HRMS.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1200"
             Background="White">
    <UserControl.DataContext>
        <vm:RecruitmentViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Color x:Key="PrimaryColor">#1E4368</Color>
        <Color x:Key="AccentColor">#FDBD55</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

        <Style x:Key="ModuleCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDE8F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="RecruitmentDialogCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="24"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8E5F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.24" Color="#10283F"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border" BasedOn="{StaticResource ModuleCardStyle}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A6A7C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C7D8EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FBFF"/>
        </Style>

        <Style x:Key="InputComboStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C7D8EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FBFF"/>
        </Style>

        <Style x:Key="FormWrapPanelStyle" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="FormFieldStackStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="FormActionStackStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="126"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="InputDateStyle"
               TargetType="DatePicker"
               BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="Language" Value="en-GB"/>
            <Setter Property="SelectedDateFormat" Value="Short"/>
            <Style.Resources>
                <Style TargetType="{x:Type DatePickerTextBox}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0,28,0"/>
                    <Setter Property="Foreground" Value="#1F1F1F"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="DateFieldBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="BorderBrush" Value="#C7D8EE"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridDateFieldBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="BorderBrush" Value="#C7D8EE"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#EAF2FB"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#2E9D5B"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#D84343"/>
        </Style>

        <Style x:Key="RecruitmentContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="210"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="#D8E5F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#17324D" BlurRadius="18" ShadowDepth="4" Opacity="0.2"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecruitmentMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="196"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemSurface"
                                Margin="0,1"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="7">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemSurface" Property="Background" Value="#EAF2FB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8B98A6"/>
                                <Setter Property="Opacity" Value="0.58"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecruitmentMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Margin" Value="11,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#E2EBF5" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RecruitmentRowStyle" TargetType="DataGridRow">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F1FC"/>
                    <Setter Property="Foreground" Value="#1E4368"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecruitmentDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9FBFF"/>
            <Setter Property="BorderBrush" Value="#E5EDF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EDF7"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ColumnWidth" Value="SizeToCells"/>
            <Setter Property="MinColumnWidth" Value="80"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RowStyle" Value="{StaticResource RecruitmentRowStyle}"/>
        </Style>

        <Style x:Key="RecruitmentHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF4FD"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#E5EDF7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="RecruitmentHeaderCenterStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource RecruitmentHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RecruitmentCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#1E4368"/>
            <Setter Property="TextBlock.TextWrapping" Value="NoWrap"/>
            <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style x:Key="RecruitmentGridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RecruitmentGridCenteredTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource RecruitmentGridTextStyle}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RecruitmentGridEditTextStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RecruitmentGridComboStyle" TargetType="ComboBox" BasedOn="{StaticResource InputComboStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>

        <Style x:Key="RecruitmentGridDateStyle" TargetType="DatePicker" BasedOn="{StaticResource InputDateStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="124"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>

        <Style x:Key="RecruitmentGridPrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="74"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RecruitmentGridDangerActionStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="86"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PostingStatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#6B7C90"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="30"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="OPEN">
                    <Setter Property="Background" Value="#2E9D5B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="DRAFT">
                    <Setter Property="Background" Value="#7A8795"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="CLOSED">
                    <Setter Property="Background" Value="#66788A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="CANCELLED">
                    <Setter Property="Background" Value="#D84343"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DisplayStatus}" Value="EXPIRED">
                    <Setter Property="Background" Value="#C78315"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecruitmentStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ApplicationStatusPillStyle" TargetType="Border" BasedOn="{StaticResource PostingStatusPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="HIRED"><Setter Property="Background" Value="#2E9D5B"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="OFFERED"><Setter Property="Background" Value="#2B6FAE"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="INTERVIEW"><Setter Property="Background" Value="#6C5CC5"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="SHORTLISTED"><Setter Property="Background" Value="#3D7B91"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="SCREENING"><Setter Property="Background" Value="#C78315"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="SUBMITTED"><Setter Property="Background" Value="#6B7C90"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="REJECTED"><Setter Property="Background" Value="#D84343"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="WITHDRAWN"><Setter Property="Background" Value="#7A8795"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InterviewStatusPillStyle" TargetType="Border" BasedOn="{StaticResource PostingStatusPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="SCHEDULED"><Setter Property="Background" Value="#2B6FAE"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="DONE"><Setter Property="Background" Value="#2E9D5B"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="CANCELLED"><Setter Property="Background" Value="#D84343"/></DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NO_SHOW"><Setter Property="Background" Value="#C78315"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OfferStatusPillStyle" TargetType="Border" BasedOn="{StaticResource PostingStatusPillStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding OfferStatus}" Value="PENDING"><Setter Property="Background" Value="#C78315"/></DataTrigger>
                <DataTrigger Binding="{Binding OfferStatus}" Value="ACCEPTED"><Setter Property="Background" Value="#2E9D5B"/></DataTrigger>
                <DataTrigger Binding="{Binding OfferStatus}" Value="DECLINED"><Setter Property="Background" Value="#D84343"/></DataTrigger>
                <DataTrigger Binding="{Binding OfferStatus}" Value="CANCELLED"><Setter Property="Background" Value="#7A8795"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabCountBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#E8F1FC"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BriefcaseAccount"
                                             Width="34"
                                             Height="32"
                                             Margin="0,0,10,0"
                                             Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Recruitment Administration"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Manage job postings, applicants, pipeline, interviews, and offers." Foreground="#5A6A7C" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Width="190"
                        Height="42"
                        Margin="0,0,8,0"
                        Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Back to Dashboard" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Width="140"
                        Height="42"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>



        <TabControl Grid.Row="2">
            <TabItem x:Name="JobPostingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Job Postings" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource TabCountBadgeStyle}">
                            <TextBlock Text="{Binding TotalPostings}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource ModuleCardStyle}" Padding="12" Margin="0,0,0,10" Background="#F8FBFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding PostingSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search code, job title, department, or position"/>

                            <ComboBox Grid.Column="1"
                                      Margin="8,0,8,0"
                                      Style="{StaticResource InputComboStyle}"
                                      ItemsSource="{Binding PostingStatusFilters}"
                                      SelectedItem="{Binding SelectedPostingStatusFilter}"
                                      materialDesign:HintAssist.Hint="Status"/>

                            <Button Grid.Column="2"
                                    Height="38"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="NewPostingButton_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,7,0"/>
                                    <TextBlock Text="New Job Posting"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource ModuleCardStyle}" Padding="6" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding JobPostings}"
                                  Style="{StaticResource RecruitmentDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource RecruitmentHeaderStyle}"
                                  CellStyle="{StaticResource RecruitmentCellStyle}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn ElementStyle="{StaticResource RecruitmentGridTextStyle}" Header="Code" Binding="{Binding PostingCode}" Width="125"/>
                                <DataGridTextColumn ElementStyle="{StaticResource RecruitmentGridTextStyle}" Header="Job Title" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTemplateColumn Header="Department" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DepartmentName}" TextAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PositionName}" TextAlignment="Center" FontSize="12" Foreground="#6A7684" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn ElementStyle="{StaticResource RecruitmentGridCenteredTextStyle}" Header="Vacancies" HeaderStyle="{StaticResource RecruitmentHeaderCenterStyle}" Binding="{Binding Vacancies}" Width="90"/>
                                <DataGridTextColumn ElementStyle="{StaticResource RecruitmentGridCenteredTextStyle}" Header="Applicants" HeaderStyle="{StaticResource RecruitmentHeaderCenterStyle}" Binding="{Binding ApplicationCount}" Width="95"/>
                                <DataGridTextColumn ElementStyle="{StaticResource RecruitmentGridTextStyle}" Header="Deadline" Binding="{Binding CloseDateText}" Width="125"/>
                                <DataGridTemplateColumn Header="Status" HeaderStyle="{StaticResource RecruitmentHeaderCenterStyle}" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PostingStatusPillStyle}">
                                                <TextBlock Text="{Binding DisplayStatus}" Style="{StaticResource RecruitmentStatusTextStyle}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" HeaderStyle="{StaticResource RecruitmentHeaderCenterStyle}" Width="82">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="38" Height="32" Padding="0"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="Posting actions"
                                                    Click="PostingActionsButton_OnClick">
                                                <materialDesign:PackIcon Kind="DotsHorizontal" Width="19" Height="19"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="CandidatesTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Candidates" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource TabCountBadgeStyle}">
                            <TextBlock Text="{Binding TotalApplicants}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <TabControl x:Name="CandidateViewsTabControl" Margin="0,8,0,0">
                    <TabItem Header="Candidate Directory">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
