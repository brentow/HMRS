<Window x:Class="HRMS.View.BiometricAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Biometric Attendance"
        Width="1280"
        Height="760"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#F5F8FC">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1E4368" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#173653" />
        <SolidColorBrush x:Key="TextBrush" Color="#12385A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5B6A7A" />
        <SolidColorBrush x:Key="LineBrush" Color="#DCE7F3" />
        <SolidColorBrush x:Key="SoftBlueBrush" Color="#EDF5FF" />
        <SolidColorBrush x:Key="SoftGreenBrush" Color="#EAF8F0" />
        <SolidColorBrush x:Key="SoftYellowBrush" Color="#FFF7E8" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D84343" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E9D5B" />

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="KioskButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource KioskButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <Style x:Key="DtrHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F6FB" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#CAD8E8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,3" />
        </Style>

        <Style x:Key="DtrCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#D7E1EC" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="DtrRemarksCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource DtrCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="TextBlock.TextAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0,4,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="54"
                            Height="54"
                            CornerRadius="8"
                            Background="#2B5B86"
                            BorderBrush="#497BAA"
                            BorderThickness="1"
                            Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="Fingerprint"
                                                 Width="32"
                                                 Height="32"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding PageSubtitle}"
                                   Foreground="#D8E8F6"
                                   FontSize="14" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="18,0,18,0">
                    <TextBlock Text="{Binding CurrentDateText}"
                               Foreground="#D8E8F6"
                               FontSize="14"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding CurrentTimeText}"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               HorizontalAlignment="Right" />
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource SmallButtonStyle}"
                        Background="#2B5B86"
                        BorderBrush="#497BAA"
                        Click="CloseButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Close" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,20">
                <Border MaxWidth="1500"
                        HorizontalAlignment="Center"
                        Style="{StaticResource PanelStyle}"
                        Padding="38,28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Employee Verification"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold" />
                                <TextBlock Text="No employee selection needed — the fingerprint identifies the person."
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13" />
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    Background="#EAF2FB"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    BorderBrush="#D5E3F5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" Margin="0,0,8,0" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,12,0,20"
                                    HorizontalAlignment="Center">
                            <Border Width="118"
                                    Height="118"
                                    HorizontalAlignment="Center"
                                    Background="#E9F2FC"
                                    BorderBrush="#C9DDF2"
                                    BorderThickness="1"
                                    CornerRadius="59">
                                <materialDesign:PackIcon Kind="Account"
                                                         Width="68"
                                                         Height="68"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedEmployeeName}"
                                       Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding SelectedEmployeeNo}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#F7FAFD"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="22,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="22" Background="#EAF2FB">
                                        <materialDesign:PackIcon Kind="CalendarClockOutline"
                                                                 Width="23" Height="23"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentDateText}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding CurrentTimeText}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="22"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#F7FAFD"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="22,12">
                                <StackPanel>
                                    <TextBlock Text="Fingerprint Device"
                                               Style="{StaticResource LabelStyle}" />
                                    <ComboBox ItemsSource="{Binding Devices}"
                                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="DisplayName"
                                              IsEnabled="{Binding CanChangeDevice}"
                                              Height="40"
                                              Margin="0,5,0,0"
                                              Padding="9,3"
                                              FontSize="13" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Height="84"
                                    Style="{StaticResource KioskButtonStyle}"
                                    Command="{Binding TimeInCommand}"
                                    Click="PunchButton_OnClick"
                                    Tag="Time-In"
                                    IsEnabled="{Binding CanPunch}"
                                    Background="{StaticResource SuccessBrush}"
                                    BorderBrush="{StaticResource SuccessBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Login" Width="27" Height="27" Margin="0,0,10,0" />
                                    <TextBlock Text="Time In" FontSize="20" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Height="84"
                                    Style="{StaticResource KioskButtonStyle}"
                                    Command="{Binding TimeOutCommand}"
                                    Click="PunchButton_OnClick"
                                    Tag="Time-Out"
                                    IsEnabled="{Binding CanPunch}"
                                    Background="{StaticResource DangerBrush}"
                                    BorderBrush="{StaticResource DangerBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Logout" Width="27" Height="27" Margin="0,0,10,0" />
                                    <TextBlock Text="Time Out" FontSize="20" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SoftGreenBrush}" CornerRadius="8" Padding="18,13">
                                <StackPanel>
                                    <TextBlock Text="Morning In" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding MorningInText}" Style="{StaticResource ValueStyle}" FontSize="18" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource SoftBlueBrush}" CornerRadius="8" Padding="18,13">
                                <StackPanel>
                                    <TextBlock Text="Morning Out" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding MorningOutText}" Style="{StaticResource ValueStyle}" FontSize="18" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="#F4F2FF" CornerRadius="8" Padding="18,13">
                                <StackPanel>
                                    <TextBlock Text="Afternoon In" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding AfternoonInText}" Style="{StaticResource ValueStyle}" FontSize="18" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Background="{StaticResource SoftYellowBrush}" CornerRadius="8" Padding="18,13">
                                <StackPanel>
                                    <TextBlock Text="Afternoon Out" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding AfternoonOutText}" Style="{StaticResource ValueStyle}" FontSize="18" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="5"
                                Margin="0,14,0,0"
                                Background="#F7FAFD"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Last Punch" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding LastPunchText}"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="17"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Today's Worked Time"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{Binding WorkedText}"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="17"
                                               FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#EDF5FF"
                BorderBrush="#D5E3F5"
                BorderThickness="1,1,0,0"
                Padding="24,12">
            <TextBlock Text="{Binding ActionMessage}"
                       Foreground="{Binding ActionMessageBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <!--
            The scan prompt deliberately sits over the existing kiosk rather than
            replacing it. The Time In/Time Out commands still own all validation,
            fingerprint matching, persistence, and refresh behavior.
        -->
        <Grid x:Name="FingerprintPromptOverlay"
              Grid.RowSpan="3"
              Panel.ZIndex="100"
              Background="#A61B2633"
              Visibility="Collapsed">
            <Border Width="590"
                    MinHeight="340"
                    Padding="28,24,28,22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28"
                                      Direction="270"
                                      ShadowDepth="8"
                                      Opacity="0.35"
                                      Color="#08111B" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="FingerprintPromptTitle"
                               Text="Time-In"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#24364A" />

                    <StackPanel Grid.Row="1"
                                Margin="0,28,0,26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="92"
                                Height="92"
                                HorizontalAlignment="Center"
                                Background="#EEF4FA"
                                CornerRadius="46">
                            <materialDesign:PackIcon Kind="Fingerprint"
                                                     Width="58"
                                                     Height="58"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="#52677C" />
                        </Border>

                        <TextBlock Text="Put your finger on the fingerprint device."
                                   Margin="0,20,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#536274" />
                        <TextBlock Text="{Binding ActionMessage}"
                                   Width="500"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{Binding ActionMessageBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="#7A8796"
                                   FontSize="12">
                            <Run Text="{Binding SelectedEmployeeName, Mode=OneWay}" />
                            <Run Text="  •  " />
                            <Run Text="{Binding SelectedDeviceName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Row="2"
                            HorizontalAlignment="Right"
                            MinWidth="88"
                            Height="38"
                            Padding="16,6"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#536274"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Content="Close"
                            Click="CloseFingerprintPrompt_OnClick" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
