<UserControl x:Class="HRMS.View.AttendanceWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1200"
             Background="White">
    <UserControl.Resources>
        <Color x:Key="PrimaryColor">#1E4368</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="22"
                          ShadowDepth="3"
                          Color="#55000000"
                          Opacity="0.35" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5EDF7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="#F9FBFF" />
            <Setter Property="BorderBrush" Value="#E5EDF7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="66" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F7FD" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
            <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1E4368" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F1FC" />
                    <Setter Property="Foreground" Value="#1E4368" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClockOutline"
                                             Width="34"
                                             Height="32"
                                             Margin="0,0,10,0"
                                             Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="{Binding AttendancePageTitle}" FontSize="25" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding AttendancePageSubtitle}" Margin="0,2,0,0" Foreground="#5B6A7A" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="190"
                        Height="42"
                        Margin="0,0,8,0"
                        Style="{StaticResource ButtonStyle}"
                        Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="ArrowLeft"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Width="140"
                        Height="42"
                        Style="{StaticResource ButtonStyle}"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Refresh"
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>



        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="6,0,6,8" Padding="10">
            <TabControl x:Name="AttendanceTabControl">
                <TabItem x:Name="DtrTab" Header="{Binding DtrTabHeader}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="DtrDailyRowDefinition" Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Employee" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Year" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="8,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Month" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="8,0,0,6" />

                                <ComboBox Grid.Row="1"
                                          Grid.Column="0"
                                          Height="36"
                                          ItemsSource="{Binding DtrEmployeeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedDtrEmployeeId}"
                                          IsEnabled="{Binding IsAdminOrHrMode}" />
                                <ComboBox Grid.Row="1"
                                          Grid.Column="1"
                                          Height="36"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding DtrYearOptions}"
                                          SelectedItem="{Binding SelectedDtrYear}" />
                                <ComboBox Grid.Row="1"
                                          Grid.Column="2"
                                          Height="36"
                                          Margin="8,0,0,0"
                                          ItemsSource="{Binding DtrMonthOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedDtrMonth}" />
                                <Button Grid.Row="1"
                                        Grid.Column="3"
                                        Style="{StaticResource ButtonStyle}"
                                        Margin="8,0,0,0"
                                        Command="{Binding LoadDtrCommand}"
                                        Content="Load" />
                                <Button Grid.Row="1"
                                        Grid.Column="4"
                                        Style="{StaticResource ButtonStyle}"
                                        Width="106"
                                        Margin="8,0,0,0"
                                        Background="#EAF2FB"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        BorderBrush="#D2E2F6"
                                        BorderThickness="1"
                                        Command="{Binding ExportDtrCsvCommand}"
                                        Content="Export" />

                                <StackPanel Grid.RowSpan="2"
                                            Grid.Column="6"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="18,0,0,0">
                                    <TextBlock Text="{Binding DtrSummaryText}" Foreground="#4A5B6C" FontWeight="SemiBold" TextAlignment="Right" />
                                    <TextBlock Text="{Binding DtrTotalWorkedHoursText, StringFormat=Total Worked: {0}}" Foreground="#4A5B6C" FontSize="12" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
                                <Border Style="{StaticResource SummaryCardStyle}" Background="#F1FBF5" BorderBrush="#CDEBD9">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DtrPresentCount}" FontSize="22" FontWeight="Bold" Foreground="#2E9D5B" />
                                        <TextBlock Text="Present" Foreground="#4A5B6C" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCardStyle}" Background="#FFF8EA" BorderBrush="#F0D49D">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DtrLateCount}" FontSize="22" FontWeight="Bold" Foreground="#B9831A" />
                                        <TextBlock Text="Late" Foreground="#4A5B6C" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCardStyle}" Background="#FFF1F1" BorderBrush="#F0C5C5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DtrAbsentCount}" FontSize="22" FontWeight="Bold" Foreground="#D84343" />
                                        <TextBlock Text="Absent" Foreground="#4A5B6C" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCardStyle}" Background="#F2F6FF" BorderBrush="#CEDCF7" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DtrLeaveOrHolidayCount}" FontSize="22" FontWeight="Bold" Foreground="#2F80ED" />
                                        <TextBlock Text="Leave / Holiday" Foreground="#4A5B6C" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,2,0,8">
                            <DataGrid MinHeight="0"
                                      ItemsSource="{Binding DtrDailyRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      RowHeaderWidth="0"
                                      ColumnHeaderHeight="38"
                                      RowHeight="42"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E9F0FA"
                                      VerticalGridLinesBrush="#E9F0FA"
                                      AlternatingRowBackground="#F8FBFF"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style BasedOn="{StaticResource HeaderStyle}" TargetType="DataGridColumnHeader"/>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style BasedOn="{StaticResource GridCellStyle}" TargetType="DataGridCell" />
                                </DataGrid.CellStyle>
                                <DataGrid.RowStyle>
                                    <Style BasedOn="{StaticResource GridRowStyle}" TargetType="DataGridRow" />
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="2.2*" />
                                    <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="1.1*" />
                                    <DataGridTextColumn Header="Time In" Binding="{Binding TimeInText}" Width="1*" />
                                    <DataGridTextColumn Header="Time Out" Binding="{Binding TimeOutText}" Width="1*" />
                                    <DataGridTextColumn Header="Late" Binding="{Binding LateText}" Width="0.8*" />
                                    <DataGridTextColumn Header="Undertime" Binding="{Binding UndertimeText}" Width="0.9*" />
                                    <DataGridTemplateColumn Header="Status" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusBrush}"
                                                        CornerRadius="12"
                                                        Padding="12,4"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="No attendance records found."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#6A7684"
                                       FontWeight="SemiBold"
                                       Visibility="{Binding IsDtrEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                    </Grid>
                </TabItem>
                <TabItem x:Name="ShiftAssignmentsTab" Header="{Binding ShiftAssignmentsTabHeader}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0,0,0,8"
                                Padding="10"
                                Background="#F8FBFF"
                                BorderBrush="#D5E3F5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsEmployeeMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Foreground="#4A5B6C"
                                       Text="{Binding ShiftAssignmentsInfoText}" />
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,0,0,8"
                                Padding="10"
                                Background="#F8FBFF"
                                BorderBrush="#D5E3F5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsEmployeeMode, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Current Shift" Foreground="#4A5B6C" />
                                    <TextBlock Text="{Binding EmployeeCurrentShiftSummary}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="This Week" Foreground="#4A5B6C" />
                                    <TextBlock Text="{Binding EmployeeWeekShiftSummary}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="AssignmentToolbar"
                              Grid.Row="2"
                              Margin="0,0,0,8"
                              Visibility="{Binding IsAdminOrHrMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ShiftAssignments.Count, StringFormat=Assignments: {0}}"
                                       VerticalAlignment="Center"
                                       Foreground="#4A5B6C"
                                       FontWeight="SemiBold" />
                            <Button x:Name="OpenAssignmentPopupButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ButtonStyle}"
                                    Click="OpenAssignmentPopup_OnClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Assign Shift" />
                                </StackPanel>
                            </Button>

                            <Popup x:Name="AssignmentPopup"
                                   PlacementTarget="{Binding ElementName=OpenAssignmentPopupButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-610"
                                   VerticalOffset="8"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Width="730"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#D5E3F5"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Effect="{StaticResource PopupShadow}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Assign Shift" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Employee" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ComboBox Height="36" ItemsSource="{Binding EmployeeOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedAssignmentEmployeeId}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,10">
                                            <TextBlock Text="Shift" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ComboBox Height="36" ItemsSource="{Binding ShiftOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedAssignmentShiftId}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,8,10">
                                            <TextBlock Text="Start date" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <Border Height="36" BorderBrush="#D5E3F5" BorderThickness="1" CornerRadius="8" Background="#F8FBFF">
                                                <DatePicker BorderThickness="0"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            Background="Transparent"
                                                            SelectedDate="{Binding NewAssignmentStartDate}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10">
                                            <TextBlock Text="End date" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <Border Height="36" BorderBrush="#D5E3F5" BorderThickness="1" CornerRadius="8" Background="#F8FBFF">
                                                <DatePicker BorderThickness="0"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            Background="Transparent"
                                                            SelectedDate="{Binding NewAssignmentEndDate}" />
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Width="150" HorizontalAlignment="Left">
                                            <TextBlock Text="Status" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ComboBox Height="36" ItemsSource="{Binding AssignmentStatuses}" SelectedItem="{Binding NewAssignmentStatus}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Button Style="{StaticResource ButtonStyle}" Background="#EAF2FB" Foreground="{StaticResource PrimaryBrush}" BorderBrush="#D2E2F6" BorderThickness="1" Margin="0,0,8,0" Click="CloseAssignmentPopup_OnClick" Content="Close" />
                                            <Button Style="{StaticResource ButtonStyle}" Command="{Binding AddAssignmentCommand}" Content="Assign" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <DataGrid Grid.Row="3"
                                  Margin="0,2,0,0"
                                  ItemsSource="{Binding ShiftAssignments}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="38"
                                  RowHeight="44"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E9F0FA"
                                  VerticalGridLinesBrush="#E9F0FA"
                                  AlternatingRowBackground="#F8FBFF"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style BasedOn="{StaticResource HeaderStyle}" TargetType="DataGridColumnHeader"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style BasedOn="{StaticResource GridCellStyle}" TargetType="DataGridCell" />
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style BasedOn="{StaticResource GridRowStyle}" TargetType="DataGridRow" />
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="2.1*" />
                                <DataGridTextColumn Header="Shift" Binding="{Binding ShiftName}" Width="1.4*" />
                                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDateText}" Width="1.2*" />
                                <DataGridTextColumn Header="End Date" Binding="{Binding EndDateText}" Width="1*" />
                                <DataGridTemplateColumn Header="Status" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBrush}"
                                                    CornerRadius="12"
                                                    Padding="12,4"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusText}"
                                                           Foreground="White"
                                                           FontWeight="SemiBold"
                                                           FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ShiftAssignmentActionsColumn" Header="Actions" Width="2.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="4,0"
                                                        Visibility="{Binding DataContext.IsAdminOrHrMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                <Button Style="{StaticResource SmallButtonStyle}" Background="#EAF2FB" Foreground="{StaticResource PrimaryBrush}" BorderBrush="#D2E2F6" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,6,0"
                                                        Content="{Binding ToggleStatusText}"
                                                        Command="{Binding DataContext.ToggleAssignmentStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SmallButtonStyle}" Background="#D84343" Content="Delete" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.DeleteAssignmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ShiftsTab"
                         Header="Shifts"
                         Visibility="{Binding IsAdminOrHrMode, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="ShiftToolbar" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Shifts.Count, StringFormat=Shifts: {0}}"
                                       VerticalAlignment="Center"
                                       Foreground="#4A5B6C"
                                       FontWeight="SemiBold" />
                            <Button x:Name="OpenShiftPopupButton"
                                    Grid.Column="1"
                                    Style="{StaticResource ButtonStyle}"
                                    Click="OpenShiftPopup_OnClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Add Shift" />
                                </StackPanel>
                            </Button>

                            <Popup x:Name="ShiftPopup"
                                   PlacementTarget="{Binding ElementName=OpenShiftPopupButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-500"
                                   VerticalOffset="8"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Width="620"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#D5E3F5"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Effect="{StaticResource PopupShadow}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Add Shift" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Shift name" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBox Height="36" Text="{Binding NewShiftName}" ToolTip="Shift name" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,10">
                                            <TextBlock Text="Start" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBox Height="36" Text="{Binding NewShiftStart}" ToolTip="HH:mm" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock Text="End" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBox Height="36" Text="{Binding NewShiftEnd}" ToolTip="HH:mm" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <StackPanel Width="110" Margin="0,0,8,0">
                                                <TextBlock Text="Break" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <TextBox Height="36" Text="{Binding NewShiftBreakMinutes}" />
                                            </StackPanel>
                                            <StackPanel Width="110" Margin="0,0,8,0">
                                                <TextBlock Text="Grace" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <TextBox Height="36" Text="{Binding NewShiftGraceMinutes}" />
                                            </StackPanel>
                                            <CheckBox Content="Overnight"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,0,9"
                                                      IsChecked="{Binding NewShiftIsOvernight}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <Button Style="{StaticResource ButtonStyle}" Background="#EAF2FB" Foreground="{StaticResource PrimaryBrush}" BorderBrush="#D2E2F6" BorderThickness="1" Margin="0,0,8,0" Click="CloseShiftPopup_OnClick" Content="Close" />
                                            <Button Style="{StaticResource ButtonStyle}" Command="{Binding AddShiftCommand}" Content="Save Shift" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <DataGrid Grid.Row="1"
                                  Margin="0,2,0,0"
                                  ItemsSource="{Binding Shifts}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="38"
                                  RowHeight="44"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E9F0FA"
                                  VerticalGridLinesBrush="#E9F0FA"
                                  AlternatingRowBackground="#F8FBFF"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style BasedOn="{StaticResource HeaderStyle}" TargetType="DataGridColumnHeader"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style BasedOn="{StaticResource GridCellStyle}" TargetType="DataGridCell" />
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style BasedOn="{StaticResource GridRowStyle}" TargetType="DataGridRow" />
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Shift" Binding="{Binding ShiftName}" Width="2*" />
                                <DataGridTextColumn Header="Time" Binding="{Binding ScheduleText}" Width="1.8*" />
                                <DataGridTextColumn Header="Break" Binding="{Binding BreakMinutes}" Width="0.9*" />
                                <DataGridTextColumn Header="Grace" Binding="{Binding GraceMinutes}" Width="0.9*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding OvernightText}" Width="1*" />
                                <DataGridTemplateColumn Header="Action" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SmallButtonStyle}" Background="#D84343" Content="Delete" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"
                                                    Command="{Binding DataContext.DeleteShiftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="AttendanceRemarksTab" Header="{Binding AttendanceRemarksTabHeader}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="RemarkToolbar" Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,10,0"
                                    Padding="10,6"
                                    Background="#F2F7FD"
                                    BorderBrush="#E0EAF6"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0" Foreground="#7A8FA5" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="14"
                                             Foreground="#5B6A7A"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding AttendanceRemarkSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Search employee, date, remark type, or details" />
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Foreground="#6A7684"
                                       FontWeight="SemiBold"
                                       Text="{Binding AttendanceRemarks.Count, StringFormat=Rows: {0}}" />
                            <Button x:Name="OpenRemarkPopupButton"
                                    Grid.Column="2"
                                    Style="{StaticResource ButtonStyle}"
                                    Click="OpenRemarkPopup_OnClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Add Entry" />
                                </StackPanel>
                            </Button>

                            <Popup x:Name="RemarkPopup"
                                   PlacementTarget="{Binding ElementName=OpenRemarkPopupButton}"
                                   Placement="Bottom"
                                   HorizontalOffset="-600"
                                   VerticalOffset="8"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Width="720"
                                        Padding="14"
                                        Background="White"
                                        BorderBrush="#D5E3F5"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Effect="{StaticResource PopupShadow}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Travel / Holiday Entry" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12" />

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                            <TextBlock Text="Employee" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ComboBox Height="36"
                                                      ItemsSource="{Binding EmployeeOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedRemarkEmployeeId}"
                                                      IsEnabled="{Binding IsAdminOrHrMode}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,10">
                                            <TextBlock Text="Work date" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <Border Height="36" BorderBrush="#D5E3F5" BorderThickness="1" CornerRadius="8" Background="#F8FBFF">
                                                <DatePicker BorderThickness="0"
                                                            Padding="8,0"
                                                            VerticalContentAlignment="Center"
                                                            Background="Transparent"
                                                            SelectedDate="{Binding NewAttendanceRemarkDate}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock Text="Type" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ComboBox Height="36"
                                                      ItemsSource="{Binding AttendanceRemarkTypeOptions}"
                                                      SelectedItem="{Binding SelectedRemarkType}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                            <TextBlock Text="Details" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <TextBox Height="36"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding NewAttendanceRemarkDetails, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button Style="{StaticResource ButtonStyle}" Background="#EAF2FB" Foreground="{StaticResource PrimaryBrush}" BorderBrush="#D2E2F6" BorderThickness="1" Margin="0,0,8,0" Click="CloseRemarkPopup_OnClick" Content="Close" />
                                            <Button Style="{StaticResource ButtonStyle}" Background="#D84343" Margin="0,0,8,0" Command="{Binding DeleteAttendanceRemarkCommand}" CommandParameter="{Binding SelectedAttendanceRemark}" Content="Delete" />
                                            <Button Style="{StaticResource ButtonStyle}" Command="{Binding SaveAttendanceRemarkCommand}" Content="Save" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  Margin="0,2,0,0"
                                  ItemsSource="{Binding AttendanceRemarks}"
                                  SelectedItem="{Binding SelectedAttendanceRemark}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="38"
                                  RowHeight="44"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E9F0FA"
                                  VerticalGridLinesBrush="#E9F0FA"
                                  AlternatingRowBackground="#F8FBFF"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.ColumnHeaderStyle>
                                <Style BasedOn="{StaticResource HeaderStyle}" TargetType="DataGridColumnHeader"/>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style BasedOn="{StaticResource GridCellStyle}" TargetType="DataGridCell" />
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style BasedOn="{StaticResource GridRowStyle}" TargetType="DataGridRow" />
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="2*" />
                                <DataGridTextColumn Header="Work Date" Binding="{Binding WorkDateText}" Width="1.1*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding RemarkType}" Width="0.7*" />
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2.3*" />
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtText}" Width="1.3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="6,0,6,0" Padding="10,8" Background="#F9FBFF">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ActionMessage}" Foreground="{Binding ActionMessageBrush}" FontWeight="SemiBold" />
                <ProgressBar Grid.Column="1" Width="120" Height="8" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
