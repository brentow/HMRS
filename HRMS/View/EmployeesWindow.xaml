<UserControl x:Class="HRMS.View.EmployeesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:HRMS.View"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="White">

    <UserControl.Resources>
        <Color x:Key="PrimaryColor">#1E4368</Color>
        <Color x:Key="LightColor">#CBE9FE</Color>
        <Color x:Key="AccentColor">#FDBD55</Color>
        <local:GovernmentIdMaskConverter x:Key="GovernmentIdMaskConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="LightBrush" Color="{StaticResource LightColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E8EF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinHeight" Value="90" />
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.93" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
            <Setter Property="Background" Value="#EAF2FB" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D5E3F5" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6A7A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="FieldBoxStyle" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="DateFieldBoxStyle" TargetType="DatePicker" BasedOn="{StaticResource FieldBoxStyle}">
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType={x:Type local:EmployeesWindow}}}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Setter Property="Focusable" Value="True" />
                </DataTrigger>
            </Style.Triggers>
            <Style.Resources>
                <Style TargetType="{x:Type DatePickerTextBox}">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="8,0,8,0" />
                </Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="ReadOnlyFieldBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldBoxStyle}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Arrow" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType={x:Type local:EmployeesWindow}}}" Value="True">
                    <Setter Property="IsReadOnly" Value="False" />
                    <Setter Property="IsReadOnlyCaretVisible" Value="True" />
                    <Setter Property="Focusable" Value="True" />
                    <Setter Property="Cursor" Value="IBeam" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailSectionCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E8EF" />
        </Style>

        <Style x:Key="DetailFieldCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E3E8EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="62" />
        </Style>

        <Style x:Key="DetailSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DetailSectionSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7C90" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="DetailFieldTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7C90" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DetailFieldValueTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ReadOnlyFieldBoxStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailFieldComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource FieldBoxStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DetailFieldDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource DateFieldBoxStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Style.Resources>
                <Style TargetType="{x:Type DatePickerTextBox}">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="DetailFieldValueTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </UserControl.Resources>

    <Grid x:Name="EmployeesRoot" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountGroupOutline"
                                             Width="36"
                                             Height="33"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Margin="0,0,10,0" />
                    <TextBlock x:Name="PageTitleText"
                               Text="Employees"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="PageSubtitleText"
                           Text="Employee masterlist, profile details, salary/appointment, and government IDs"
                           Foreground="#5B6A7A"
                           Margin="0,2,0,0" />
            </StackPanel>

            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackToDashboardButton"
                        Grid.Column="0"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="0,0,8,0"
                        Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="SelectEmployeeButton"
                        Grid.Column="1"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Margin="8,0,8,0"
                        Click="SelectEmployeeButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountSearchOutline" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Select Employee" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="AddEmployeeButton"
                        Grid.Column="2"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Margin="8,0,8,0"
                        Click="AddEmployeeButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="Add Employee" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditProfileButton"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Click="EditProfileButton_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon x:Name="EditProfileIcon" Kind="AccountEditOutline" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock x:Name="EditProfileText" Text="Edit Profile" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource CardStyle}">
                <Grid x:Name="EmployeeDetailsCard">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42"
                                Height="42"
                                CornerRadius="21"
                                Background="#EAF2FB"
                                Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="AccountCircle"
                                                     Width="24"
                                                     Height="24"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedEmployee.Name, TargetNullValue=No Employee Selected, FallbackValue=No Employee Selected}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedEmployee.EmployeeNo, StringFormat=Employee ID: {0}, TargetNullValue=Employee ID: -, FallbackValue=Employee ID: -}"
                                       Foreground="#5B6A7A"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button x:Name="SaveProfileButton"
                                Grid.Column="2"
                                Visibility="Collapsed"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Height="38"
                                Margin="12,0,0,0"
                                MinWidth="120"
                                Click="SaveProfileButton_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                <TextBlock Text="Save" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="EmployeeDetailsScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Margin="12,12,12,0"
                                    Style="{StaticResource DetailSectionCardStyle}"
                                    Background="White">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42"
                                                Height="42"
                                                CornerRadius="21"
                                                Background="#F2F4F7"
                                                VerticalAlignment="Top">
                                            <materialDesign:PackIcon Kind="AccountDetailsOutline"
                                                                     Width="22"
                                                                     Height="22"
                                                                     Foreground="{StaticResource PrimaryBrush}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Employee Profile"
                                                       Style="{StaticResource DetailSectionTitleStyle}" />
                                            <TextBlock Text="Basic information, work details, and required records."
                                                       Style="{StaticResource DetailSectionSubtitleStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Margin="0,0,10,0"
                                                Background="#F8FBFF"
                                                BorderBrush="#E3ECF8"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Monthly Salary"
                                                           Foreground="#5B6A7A"
                                                           FontWeight="SemiBold"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding SelectedEmployee.MonthlySalary, StringFormat=PHP {0:N2}, TargetNullValue=PHP 0.00, FallbackValue=PHP 0.00}"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Margin="0,0,10,0"
                                                Background="#F8FBFF"
                                                BorderBrush="#E3ECF8"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Worked This Month"
                                                           Foreground="#5B6A7A"
                                                           FontWeight="SemiBold"
                                                           FontSize="12" />
                                                <TextBlock Foreground="{StaticResource PrimaryBrush}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,4,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} day(s)">
                                                            <Binding Path="SelectedEmployee.CurrentMonthWorkedDays" TargetNullValue="0" FallbackValue="0" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding SelectedEmployee.CurrentMonthWorkedHoursText, TargetNullValue=0 hrs, FallbackValue=0 hrs}"
                                                           Foreground="#5B6A7A"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Background="#F8FBFF"
                                                BorderBrush="#E3ECF8"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Last Attendance"
                                                           Foreground="#5B6A7A"
                                                           FontWeight="SemiBold"
                                                           FontSize="12" />
                                                <TextBlock Text="{Binding SelectedEmployee.CurrentMonthLastWorkDateText, TargetNullValue=--, FallbackValue=--}"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding SelectedEmployeeAttendanceSummary}"
                                                           Foreground="#5B6A7A"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,10,12"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Employee No"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <TextBox Text="{Binding SelectedEmployee.EmployeeNo, Mode=TwoWay, TargetNullValue=''}"
                                                         Style="{StaticResource DetailFieldValueTextBoxStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="0,0,0,12"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Full Name"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <TextBox Text="{Binding SelectedEmployee.Name, Mode=TwoWay, TargetNullValue=''}"
                                                         Style="{StaticResource DetailFieldValueTextBoxStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,10,12"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Department"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <Grid>
                                                    <TextBox x:Name="ProfileDepartmentTextBox"
                                                             Text="{Binding SelectedEmployee.Department, Mode=TwoWay, TargetNullValue=''}"
                                                             Style="{StaticResource DetailFieldValueTextBoxStyle}" />
                                                    <ComboBox x:Name="ProfileDepartmentComboBox"
                                                              Visibility="Collapsed"
                                                              Style="{StaticResource DetailFieldComboBoxStyle}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Name"
                                                              SelectionChanged="ProfileDepartmentComboBox_OnSelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="0,0,0,12"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Position"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <Grid>
                                                    <TextBox x:Name="ProfilePositionTextBox"
                                                             Text="{Binding SelectedEmployee.Position, Mode=TwoWay, TargetNullValue=''}"
                                                             Style="{StaticResource DetailFieldValueTextBoxStyle}" />
                                                    <ComboBox x:Name="ProfilePositionComboBox"
                                                              Visibility="Collapsed"
                                                              Style="{StaticResource DetailFieldComboBoxStyle}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Name"
                                                              SelectionChanged="ProfilePositionComboBox_OnSelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,0,10,12"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Status"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <TextBox Text="{Binding SelectedEmployee.Status, Mode=TwoWay, TargetNullValue=''}"
                                                         Style="{StaticResource DetailFieldValueTextBoxStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="0,0,0,12"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Hire Date"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <DatePicker SelectedDate="{Binding SelectedEmployee.HireDate, Mode=TwoWay}"
                                                            Style="{StaticResource DetailFieldDatePickerStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="3"
                                                Grid.Column="0"
                                                Margin="0,0,10,12"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Appointment Type"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <Grid>
                                                    <TextBox x:Name="SalaryAppointmentTypeTextBox"
                                                             Text="{Binding SelectedEmployee.AppointmentType, Mode=TwoWay, TargetNullValue=''}"
                                                             Style="{StaticResource DetailFieldValueTextBoxStyle}" />
                                                    <ComboBox x:Name="SalaryAppointmentTypeComboBox"
                                                              Visibility="Collapsed"
                                                              Style="{StaticResource DetailFieldComboBoxStyle}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Name"
                                                              SelectionChanged="SalaryAppointmentTypeComboBox_OnSelectionChanged" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="3"
                                                Grid.Column="1"
                                                Margin="0,0,0,12"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Salary Grade / Step"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0">
                                                        <TextBox x:Name="SalaryGradeTextBox"
                                                                 Text="{Binding SelectedEmployee.SalaryGrade, Mode=TwoWay, TargetNullValue=''}"
                                                                 Style="{StaticResource DetailFieldValueTextBoxStyle}" />
                                                        <ComboBox x:Name="SalaryGradeComboBox"
                                                                  Visibility="Collapsed"
                                                                  Style="{StaticResource DetailFieldComboBoxStyle}"
                                                                  SelectionChanged="SalaryGradeComboBox_OnSelectionChanged" />
                                                    </Grid>

                                                    <Grid Grid.Column="2">
                                                        <TextBox x:Name="SalaryStepTextBox"
                                                                 Text="{Binding SelectedEmployee.SalaryStep, Mode=TwoWay, TargetNullValue=''}"
                                                                 Style="{StaticResource DetailFieldValueTextBoxStyle}" />
                                                        <ComboBox x:Name="SalaryStepComboBox"
                                                                  Visibility="Collapsed"
                                                                  Style="{StaticResource DetailFieldComboBoxStyle}"
                                                                  SelectionChanged="SalaryStepComboBox_OnSelectionChanged" />
                                                    </Grid>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Style="{StaticResource DetailFieldCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Recent Attendance Logs"
                                                           Style="{StaticResource DetailFieldTitleStyle}" />
                                                <DataGrid ItemsSource="{Binding SelectedEmployeeRecentLogs}"
                                                          AutoGenerateColumns="False"
                                                          CanUserAddRows="False"
                                                          CanUserDeleteRows="False"
                                                          IsReadOnly="True"
                                                          HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal"
                                                          BorderBrush="#E3ECF8"
                                                          BorderThickness="1"
                                                          RowHeaderWidth="0"
                                                          RowBackground="White"
                                                          AlternatingRowBackground="#F8FBFF"
                                                          HorizontalGridLinesBrush="#E9F0FA"
                                                          VerticalGridLinesBrush="#E9F0FA"
                                                          ColumnHeaderHeight="38"
                                                          RowHeight="38"
                                                          MaxHeight="220"
                                                          Margin="0,8,0,0">
                                                    <DataGrid.ColumnHeaderStyle>
                                                        <Style TargetType="DataGridColumnHeader">
                                                            <Setter Property="Background" Value="#F2F7FD" />
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="BorderBrush" Value="#E3ECF8" />
                                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                            <Setter Property="Padding" Value="8,0,8,0" />
                                                        </Style>
                                                    </DataGrid.ColumnHeaderStyle>
                                                    <DataGrid.CellStyle>
                                                        <Style TargetType="DataGridCell">
                                                            <Setter Property="Padding" Value="8,0,8,0" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        </Style>
                                                    </DataGrid.CellStyle>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Date" Binding="{Binding LogDateText}" Width="130" />
                                                        <DataGridTextColumn Header="Time" Binding="{Binding LogTimeText}" Width="110" />
                                                        <DataGridTextColumn Header="Type" Binding="{Binding LogType}" Width="110" />
                                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110" />
                                                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="12"
                                    Style="{StaticResource DetailSectionCardStyle}"
                                    Background="White">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="42"
                                                    Height="42"
                                                    CornerRadius="21"
                                                    Background="#F2F4F7"
                                                    VerticalAlignment="Top">
                                                <materialDesign:PackIcon Kind="CardAccountDetailsOutline"
                                                                         Width="22"
                                                                         Height="22"
                                                                         Foreground="{StaticResource PrimaryBrush}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Government IDs"
                                                           Style="{StaticResource DetailSectionTitleStyle}" />
                                                <TextBlock Text="Registered employee numbers for statutory payroll and benefits."
                                                           Style="{StaticResource DetailSectionSubtitleStyle}" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="0,0,10,12"
                                                    Style="{StaticResource DetailFieldCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="TIN No."
                                                               Style="{StaticResource DetailFieldTitleStyle}" />
                                                    <TextBox Style="{StaticResource DetailFieldValueTextBoxStyle}">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource GovernmentIdMaskConverter}" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                                <Binding Path="SelectedEmployee.TinNo" Mode="TwoWay" TargetNullValue="" />
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="IsReadOnly" Mode="OneWay" />
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="0,0,0,12"
                                                    Style="{StaticResource DetailFieldCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="PhilHealth No."
                                                               Style="{StaticResource DetailFieldTitleStyle}" />
                                                    <TextBox Style="{StaticResource DetailFieldValueTextBoxStyle}">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource GovernmentIdMaskConverter}" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                                <Binding Path="SelectedEmployee.PhilHealthNo" Mode="TwoWay" TargetNullValue="" />
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="IsReadOnly" Mode="OneWay" />
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Grid.Column="0"
                                                    Margin="0,0,10,0"
                                                    Style="{StaticResource DetailFieldCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="GSIS BP No."
                                                               Style="{StaticResource DetailFieldTitleStyle}" />
                                                    <TextBox Style="{StaticResource DetailFieldValueTextBoxStyle}">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource GovernmentIdMaskConverter}" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                                <Binding Path="SelectedEmployee.GsisBpNo" Mode="TwoWay" TargetNullValue="" />
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="IsReadOnly" Mode="OneWay" />
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Row="1"
                                                    Grid.Column="1"
                                                    Style="{StaticResource DetailFieldCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="PAG-IBIG MID No."
                                                               Style="{StaticResource DetailFieldTitleStyle}" />
                                                    <TextBox Style="{StaticResource DetailFieldValueTextBoxStyle}">
                                                        <TextBox.Text>
                                                            <MultiBinding Converter="{StaticResource GovernmentIdMaskConverter}" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                                                <Binding Path="SelectedEmployee.PagibigMidNo" Mode="TwoWay" TargetNullValue="" />
                                                                <Binding RelativeSource="{RelativeSource Self}" Path="IsReadOnly" Mode="OneWay" />
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="EmployeePickerPopup"
               PlacementTarget="{Binding ElementName=EmployeesRoot}"
               Placement="Center"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Opened="EmployeePickerPopup_OnOpened">
            <Border Width="560"
                    MaxHeight="560"
                    Background="White"
                    BorderBrush="#D9E6F4"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="2"
                                      Opacity="0.22"
                                      Color="#223344" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountSearchOutline"
                                                     Width="24"
                                                     Height="24"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Margin="0,0,8,0" />
                            <TextBlock Text="Select Employee or User"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                Padding="0"
                                BorderThickness="0"
                                Background="#F2F5FA"
                                Click="CloseEmployeePickerButton_OnClick"
                                ToolTip="Close">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#6A7684" />
                        </Button>
                    </Grid>

                    <Border Background="#F2F7FD"
                            BorderBrush="#E0EAF6"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="#7A8FA5"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center" />
                            <TextBox x:Name="EmployeePickerSearchTextBox"
                                     Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Foreground="#5B6A7A"
                                     Text="{Binding EmployeePickerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     KeyDown="EmployeePickerSearchTextBox_OnKeyDown"
                                     materialDesign:HintAssist.Hint="Search name, user, ID, department, or position" />
                            <Button Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Click="ClearEmployeePickerSearchButton_OnClick"
                                    ToolTip="Clear">
                                <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="#7A8FA5" />
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding EmployeePickerResults.Count, StringFormat={}{0} result(s)}"
                               Foreground="#6B7C90"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="2,10,0,6" />

                    <Grid>
                        <ListBox x:Name="EmployeePickerResultsListBox"
                                 ItemsSource="{Binding EmployeePickerResults}"
                                 SelectionChanged="EmployeePickerResultsListBox_OnSelectionChanged"
                                 MaxHeight="360"
                                 BorderBrush="#E0EAF6"
                                 BorderThickness="1"
                                 Background="White"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeePickerResults.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38"
                                                Height="38"
                                                CornerRadius="19"
                                                Background="#EAF2FB"
                                                Margin="0,2,12,0">
                                            <materialDesign:PackIcon Kind="AccountCircleOutline"
                                                                     Width="22"
                                                                     Height="22"
                                                                     Foreground="{StaticResource PrimaryBrush}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding EmployeeNo, StringFormat=ID: {0}}"
                                                       FontSize="12"
                                                       Foreground="#5B6A7A"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12"
                                                       Foreground="#6A7684"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} / {1}">
                                                        <Binding Path="Department" />
                                                        <Binding Path="Position" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Background="#F2F7FD"
                                                BorderBrush="#DDE8F6"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="8,4"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="#F8FBFF"
                                BorderBrush="#E0EAF6"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18"
                                MinHeight="120">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmployeePickerResults.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="No employees found."
                                       Foreground="#6B7C90"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Grid x:Name="AddEmployeeHost"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Panel.ZIndex="10"
              Background="White">
            <local:AddEmployeeWindow x:Name="AddEmployeeForm"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     EmployeeSaved="AddEmployeeForm_EmployeeSaved"
                                     Cancelled="AddEmployeeForm_Cancelled" />
        </Grid>
    </Grid>
</UserControl>
