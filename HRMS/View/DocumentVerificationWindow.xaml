<UserControl x:Class="HRMS.View.DocumentVerificationWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1240"
             Background="White">
    <UserControl.Resources>
        <Color x:Key="PrimaryColor">#1E4368</Color>
        <Color x:Key="SuccessColor">#2E9D5B</Color>
        <Color x:Key="WarningColor">#D9B53B</Color>
        <Color x:Key="ErrorColor">#D84343</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5EDF7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F7FD" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="BorderBrush" Value="#E3ECF8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Foreground" Value="#1E4368" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F1FC" />
                    <Setter Property="Foreground" Value="#1E4368" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="BorderBrush" Value="#D6E1F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F7FAFF" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="BorderBrush" Value="#D6E1F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F7FAFF" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style x:Key="DateFieldBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#F7FAFF" />
            <Setter Property="BorderBrush" Value="#D6E1F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="EmployeeGridTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DocumentStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource EmployeeGridTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#6A7684" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="verified">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="submitted">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="expired">
                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="waived">
                    <Setter Property="Foreground" Value="#8A6D20" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrapGridTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardCheckOutline"
                                             Width="34"
                                             Height="32"
                                             Margin="0,0,10,0"
                                             Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="System Verifier"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
                <TextBlock Margin="0,2,0,0"
                           Foreground="#5B6A7A"
                           Text="Track employee document compliance, verification, and expiring requirements." />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="190"
                        Height="42"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Width="140"
                        Height="42"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="6,0,10,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Employees"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <Border Margin="0,10,0,0"
                                Padding="10,6"
                                Background="#F2F7FD"
                                BorderBrush="#E0EAF6"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify"
                                                         Width="18"
                                                         Height="18"
                                                         Margin="0,0,8,0"
                                                         Foreground="#7A8FA5"
                                                         VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Foreground="#5B6A7A"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Search employee name" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Employees}"
                              SelectedItem="{Binding SelectedEmployee}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              ColumnHeaderStyle="{StaticResource HeaderStyle}"
                              CellStyle="{StaticResource GridCellStyle}"
                              RowStyle="{StaticResource GridRowStyle}"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Employee" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Foreground="#6A7684" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding EmployeeNo}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding PositionName}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Progress"
                                                Binding="{Binding ProgressText, Mode=OneWay}"
                                                Width="90"
                                                ElementStyle="{StaticResource EmployeeGridTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Margin="0,0,6,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,2,0">
                    <Border Margin="0,0,0,10" Style="{StaticResource CardStyle}" Background="#F7FBFF">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedEmployeeTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding SelectedEmployeeSubtitle}"
                                   Foreground="#5B6A7A"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Required Employee Documents"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Only the requirements assigned to this employee are shown. Select one to review or upload a file."
                                           Margin="0,3,0,0"
                                           Foreground="#5B6A7A" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      Height="270"
                                      ItemsSource="{Binding RequiredDocuments}"
                                      SelectedItem="{Binding SelectedDocument}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                      CellStyle="{StaticResource GridCellStyle}"
                                      RowStyle="{StaticResource GridRowStyle}"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding DocumentCode}" Width="92" ElementStyle="{StaticResource EmployeeGridTextStyle}" />
                                    <DataGridTextColumn Header="Required Document" Binding="{Binding DocumentName}" Width="*" ElementStyle="{StaticResource WrapGridTextStyle}" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel, Mode=OneWay}" Width="120" ElementStyle="{StaticResource DocumentStatusTextStyle}" />
                                    <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedDate, StringFormat={}{0:MMM dd, yyyy}}" Width="118" ElementStyle="{StaticResource EmployeeGridTextStyle}" />
                                    <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat={}{0:MMM dd, yyyy}}" Width="118" ElementStyle="{StaticResource EmployeeGridTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Margin="0,0,0,10" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Document Review"
                                       Foreground="#6A7684"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedDocumentTitle}"
                                       Margin="0,2,0,0"
                                       FontWeight="Bold"
                                       FontSize="17"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       TextWrapping="Wrap" />

                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Status" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding SelectedDocumentStatus}"
                                              Style="{StaticResource ComboBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Date Submitted" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Border Style="{StaticResource DateFieldBorderStyle}">
                                        <DatePicker BorderThickness="0" Padding="8,0" Background="Transparent"
                                                    Language="en-GB" SelectedDateFormat="Short"
                                                    SelectedDate="{Binding SelectedSubmittedDate}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="Expiry Date" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Border Style="{StaticResource DateFieldBorderStyle}">
                                        <DatePicker BorderThickness="0" Padding="8,0" Background="Transparent"
                                                    Language="en-GB" SelectedDateFormat="Short"
                                                    SelectedDate="{Binding SelectedExpiryDate}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                    <TextBlock Text="Date Verified" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Border Style="{StaticResource DateFieldBorderStyle}">
                                        <DatePicker BorderThickness="0" Padding="8,0" Background="Transparent"
                                                    Language="en-GB" SelectedDateFormat="Short"
                                                    SelectedDate="{Binding SelectedVerifiedDate}" />
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="1" Grid.ColumnSpan="4"
                                        Margin="0,12,0,0" Padding="12,9"
                                        Background="#F7FAFF" BorderBrush="#D6E1F0"
                                        BorderThickness="1" CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20"
                                                                 Foreground="{StaticResource PrimaryBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Employee File" Foreground="#5B6A7A" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedDocumentAttachmentText}"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Margin="12,0,0,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Height="36" MinWidth="105"
                                                Visibility="{Binding SelectedDocumentHasAttachment, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding OpenAttachmentCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="OpenInNew" Width="15" Height="15" Margin="0,0,6,0" />
                                                <TextBlock Text="Open File" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,12,0,0">
                                    <TextBlock Text="Review Notes" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputStyle}"
                                             Text="{Binding SelectedRemarks, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Margin="0,12,0,0"
                                            Visibility="{Binding IsWaivedStatus, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Waiver Reason" Foreground="#8A6D20" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource InputStyle}"
                                             Text="{Binding SelectedWaivedReason, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Required when the document status is Waived" />
                                </StackPanel>

                                <Border Grid.Row="4" Grid.ColumnSpan="4" Margin="0,12,0,0"
                                        Padding="12" Background="#F2F7FD" CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Upload for Employee" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="HR/Admin may attach a PDF or image to this requirement."
                                                       Margin="0,2,0,0" FontSize="12" Foreground="#6A7684" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource InputStyle}"
                                                     Margin="0,0,8,0" IsReadOnly="True"
                                                     Text="{Binding SelectedUploadFilePath}"
                                                     materialDesign:HintAssist.Hint="Choose a PDF, JPG, JPEG, or PNG file" />
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                                                    Margin="0,0,8,0" Height="38" MinWidth="105"
                                                    Command="{Binding BrowseUploadFileCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="Browse" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                                    Height="38" MinWidth="160"
                                                    IsEnabled="{Binding CanUploadForEmployee}"
                                                    Command="{Binding UploadForEmployeeCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="UploadOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                                    <TextBlock Text="Upload File" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="5" Grid.ColumnSpan="4" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Margin="0,0,12,0" Padding="10,7" Background="#F7FAFF" CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActionMessage}"
                                                   Foreground="{Binding ActionMessageBrush}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0,0,8,0" MinWidth="145"
                                                Command="{Binding MarkSubmittedCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FileCheckOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                                <TextBlock Text="Mark Submitted" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0,0,8,0" MinWidth="110"
                                                Background="{StaticResource SuccessBrush}"
                                                Command="{Binding VerifyDocumentCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckDecagramOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                                <TextBlock Text="Verify" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                MinWidth="130"
                                                Command="{Binding SaveDocumentCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                                <TextBlock Text="Save" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Expiring Within 30 Days"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ExpiringDocuments.Count, StringFormat={}{0} document(s)}"
                                       Foreground="#6A7684"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding ExpiringDocuments}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  MaxHeight="190"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Emp No" Binding="{Binding EmployeeNo}" Width="95" />
                                <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="1.8*" />
                                <DataGridTextColumn Header="Document" Binding="{Binding DocumentName}" Width="2*" />
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat={}{0:MMM dd, yyyy}}" Width="120" />
                                <DataGridTextColumn Header="Days Left" Binding="{Binding DaysRemaining, Mode=OneWay}" Width="90" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
