                    </Grid>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,12"><TextBlock Text="Candidate No" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewApplicantNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="First Name" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewApplicantFirstName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,8,12"><TextBlock Text="Last Name" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewApplicantLastName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Middle Name" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewApplicantMiddleName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,8,12"><TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewApplicantEmail, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12"><TextBlock Text="Mobile" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewApplicantMobile, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Row="3" Margin="0,0,8,0"><TextBlock Text="Birth Date" Style="{StaticResource FieldLabelStyle}"/><Border Style="{StaticResource DateFieldBorderStyle}"><DatePicker Style="{StaticResource InputDateStyle}" SelectedDate="{Binding NewApplicantBirthDate}"/></Border></StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewApplicantAddress, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Width="105" Height="40" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="CloseRecruitmentDialogButton_OnClick"><TextBlock Text="Cancel"/></Button>
                        <Button Width="145" Height="40" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddApplicantCommand}" Click="CreateCandidateButton_OnClick"><TextBlock Text="Create Candidate"/></Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="NewApplicationDialog" Width="680"
                    Style="{StaticResource RecruitmentDialogCardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="New Application" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Link a candidate to an open job posting." Margin="0,3,0,0" Foreground="#6A7684"/></StackPanel>
                        <Button Grid.Column="1" Width="34" Height="34" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="CloseRecruitmentDialogButton_OnClick"><materialDesign:PackIcon Kind="Close" Width="17" Height="17"/></Button>
                    </Grid>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="Candidate" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding ApplicantOptions}" DisplayMemberPath="Label" SelectedValuePath="ApplicantId" SelectedValue="{Binding SelectedApplicationApplicantId}"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="Job Posting" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding PostingOptions}" DisplayMemberPath="Label" SelectedValuePath="JobPostingId" SelectedValue="{Binding SelectedApplicationPostingId}"/></StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Initial Status" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding ApplicationStatuses}" SelectedItem="{Binding NewApplicationStatus}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewApplicationNotes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Width="105" Height="40" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="CloseRecruitmentDialogButton_OnClick"><TextBlock Text="Cancel"/></Button>
                        <Button Width="155" Height="40" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddApplicationCommand}" Click="CreateApplicationButton_OnClick"><TextBlock Text="Create Application"/></Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="NewInterviewDialog" Width="730"
                    Style="{StaticResource RecruitmentDialogCardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Schedule Interview" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Set the schedule, interviewer, and location." Margin="0,3,0,0" Foreground="#6A7684"/></StackPanel>
                        <Button Grid.Column="1" Width="34" Height="34" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="CloseRecruitmentDialogButton_OnClick"><materialDesign:PackIcon Kind="Close" Width="17" Height="17"/></Button>
                    </Grid>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="Application" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding ApplicationOptions}" DisplayMemberPath="Label" SelectedValuePath="JobApplicationId" SelectedValue="{Binding SelectedInterviewApplicationId}"/></StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}"/><Border Style="{StaticResource DateFieldBorderStyle}"><DatePicker Style="{StaticResource InputDateStyle}" SelectedDate="{Binding NewInterviewDate}"/></Border></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Time (HH:mm)" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewInterviewTimeText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Type" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding InterviewTypes}" SelectedItem="{Binding NewInterviewType}"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Interviewer" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding EmployeeOptions}" DisplayMemberPath="Label" SelectedValuePath="EmployeeId" SelectedValue="{Binding SelectedInterviewerEmployeeId}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding InterviewStatuses}" SelectedItem="{Binding NewInterviewStatus}"/></StackPanel>
                    </Grid>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Location or Meeting Link" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewInterviewLocation, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewInterviewRemarks, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Width="105" Height="40" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="CloseRecruitmentDialogButton_OnClick"><TextBlock Text="Cancel"/></Button>
                        <Button Width="160" Height="40" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddInterviewCommand}" Click="CreateInterviewButton_OnClick"><TextBlock Text="Schedule Interview"/></Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="NewOfferDialog" Width="680"
                    Style="{StaticResource RecruitmentDialogCardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Create Job Offer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="Record the offer details for a selected application." Margin="0,3,0,0" Foreground="#6A7684"/></StackPanel>
                        <Button Grid.Column="1" Width="34" Height="34" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Click="CloseRecruitmentDialogButton_OnClick"><materialDesign:PackIcon Kind="Close" Width="17" Height="17"/></Button>
                    </Grid>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="Application" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding ApplicationOptions}" DisplayMemberPath="Label" SelectedValuePath="JobApplicationId" SelectedValue="{Binding SelectedOfferApplicationId}"/></StackPanel>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/><ComboBox Style="{StaticResource InputComboStyle}" ItemsSource="{Binding OfferStatuses}" SelectedItem="{Binding NewOfferStatus}"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Salary Offer" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewOfferSalaryText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="Start Date" Style="{StaticResource FieldLabelStyle}"/><Border Style="{StaticResource DateFieldBorderStyle}"><DatePicker Style="{StaticResource InputDateStyle}" SelectedDate="{Binding NewOfferStartDate}"/></Border></StackPanel>
                    </Grid>
                    <StackPanel><TextBlock Text="Remarks" Style="{StaticResource FieldLabelStyle}"/><TextBox Style="{StaticResource InputTextBoxStyle}" Text="{Binding NewOfferRemarks, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Width="105" Height="40" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="CloseRecruitmentDialogButton_OnClick"><TextBlock Text="Cancel"/></Button>
                        <Button Width="135" Height="40" Style="{StaticResource SuccessButtonStyle}" Command="{Binding AddOfferCommand}" Click="CreateOfferButton_OnClick"><TextBlock Text="Create Offer"/></Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource ModuleCardStyle}" Padding="10" Margin="0,10,0,0" Background="#F9FBFF">
            <TextBlock Text="{Binding ActionMessage}" Foreground="{Binding ActionMessageBrush}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</UserControl>
