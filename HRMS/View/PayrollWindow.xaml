<UserControl x:Class="HRMS.View.PayrollWindow"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Background="White">

    <UserControl.Resources>
        <Color x:Key="PrimaryColor">#1E4368</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DropShadowEffect x:Key="PopupShadow"
                          BlurRadius="22"
                          ShadowDepth="3"
                          Color="#55000000"
                          Opacity="0.35" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="#E5EDF7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E9F1FB" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#D5E3F5" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#2E9D5B" />
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#D84343" />
        </Style>

        <Style x:Key="DateFieldBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="BorderBrush" Value="#D5E3F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="GridSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource SuccessButtonStyle}">
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="GridDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="PayrollSummaryTileStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE8F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <Style x:Key="PayrollContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="MinWidth" Value="205" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#D8E5F3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>

        <Style x:Key="PayrollMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="GridMoreButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="RunIdButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1D8FDB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5F3FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D5EAFE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F2F7FD" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#E3ECF8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0,10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="TextBlock.VerticalAlignment" Value="Center" />
            <Setter Property="TextBlock.TextAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="GridCellCenterStyle" TargetType="DataGridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridActionCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource GridCellCenterStyle}">
            <Setter Property="Padding" Value="4,0,4,0" />
        </Style>

        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="50" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1E4368" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F1FC" />
                    <Setter Property="Foreground" Value="#1E4368" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashMultiple"
                                             Width="34"
                                             Height="32"
                                             Margin="0,0,10,0"
                                             Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="{Binding PageHeaderTitle}"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
                <TextBlock Margin="0,2,0,0"
                           Foreground="#5B6A7A"
                           Text="{Binding PageHeaderSubtitle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="190"
                        Height="42"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Back to Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Width="140"
                        Height="42"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Margin="6,0,6,0"
                    Style="{StaticResource CardStyle}"
                    Background="#F7FBFF"
                    Visibility="{Binding IsAdminOrHrMode, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PayrollSummaryTileStyle}" Margin="0,0,4,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Payroll Allocation" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="{Binding GgmsProgram, StringFormat=GGMS · {0}}" Foreground="#5B6A7A" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PayrollSummaryTileStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Allocated" Foreground="#6A7684" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding GgmsAllocatedAmountText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PayrollSummaryTileStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Used" Foreground="#6A7684" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding GgmsUsedAmountText}" Foreground="#B9831A" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource PayrollSummaryTileStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Remaining" Foreground="#6A7684" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding GgmsRemainingAmountText}" Foreground="#2E9D5B" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource PayrollSummaryTileStyle}" Margin="4,0,0,0" Background="#F1FAF5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CloudCheckOutline" Width="18" Height="18" Margin="0,0,8,0" Foreground="{Binding GgmsSyncStatusBrush}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding GgmsSyncStatus}"
                                       Foreground="{Binding GgmsSyncStatusBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <TabControl x:Name="PayrollTabControl" Grid.Row="2" Margin="6,0,6,8">
            <TabItem x:Name="PayrollPeriodsTab"
                     Header="{Binding PeriodsTabLabel}"
                     Visibility="Collapsed">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,10,0" Padding="10,6" Background="#F2F7FD" BorderBrush="#E0EAF6" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0" Foreground="#7A8FA5" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#5B6A7A" VerticalContentAlignment="Center"
                                         Text="{Binding PeriodSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Search period code or status" />
                            </Grid>
                        </Border>

                        <ComboBox Grid.Column="1"
                                  Height="40"
                                  ItemsSource="{Binding PeriodStatusFilters}"
                                  SelectedItem="{Binding SelectedPeriodStatusFilter}" />

                        <TextBlock Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#6A7684"
                                   FontWeight="SemiBold"
                                   Text="{Binding PayrollPeriods.Count, StringFormat=Rows: {0}}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="12"
                            Style="{StaticResource CardStyle}"
                            Background="#F9FBFF"
                            Visibility="{Binding IsAdminOrHrMode, Converter={StaticResource BoolToVis}}">
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Width="190">
                                <TextBlock Text="Period Code" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBox Height="40"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding NewPeriodCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Width="150" Margin="10,0,0,0">
                                <TextBlock Text="Date From" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Border Style="{StaticResource DateFieldBorderStyle}">
                                    <DatePicker BorderThickness="0"
                                                Padding="8,0"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                Language="en-GB"
                                                SelectedDateFormat="Short"
                                                SelectedDate="{Binding NewPeriodDateFrom}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Width="150" Margin="10,0,0,0">
                                <TextBlock Text="Date To" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Border Style="{StaticResource DateFieldBorderStyle}">
                                    <DatePicker BorderThickness="0"
                                                Padding="8,0"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                Language="en-GB"
                                                SelectedDateFormat="Short"
                                                SelectedDate="{Binding NewPeriodDateTo}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Width="150" Margin="10,0,0,0">
                                <TextBlock Text="Pay Date" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Border Style="{StaticResource DateFieldBorderStyle}">
                                    <DatePicker BorderThickness="0"
                                                Padding="8,0"
                                                VerticalContentAlignment="Center"
                                                Background="Transparent"
                                                Language="en-GB"
                                                SelectedDateFormat="Short"
                                                SelectedDate="{Binding NewPeriodPayDate}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Width="150" Margin="10,0,0,0">
                                <TextBlock Text="Status" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox Height="40"
                                          ItemsSource="{Binding EditablePeriodStatuses}"
                                          SelectedItem="{Binding NewPeriodStatus}" />
                            </StackPanel>

                            <StackPanel Grid.Column="5" Margin="10,20,0,0" VerticalAlignment="Top">
                                <Button Height="40"
                                        MinWidth="122"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding AddPeriodCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Add Period" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding PayrollPeriods}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  RowHeight="52"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FBFF"
                                  HorizontalGridLinesBrush="#E9F0FA"
                                  VerticalGridLinesBrush="#E9F0FA"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Period Code"
                                                    Binding="{Binding PeriodCode, Mode=OneWay}"
                                                    Width="1.4*"
                                                    CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Date From" Binding="{Binding DateFromText, Mode=OneWay}" Width="1*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Date To" Binding="{Binding DateToText, Mode=OneWay}" Width="1*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Pay Date" Binding="{Binding PayDateText, Mode=OneWay}" Width="1*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTemplateColumn Header="Status" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ComboBox ItemsSource="{Binding DataContext.EditablePeriodStatuses, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Width="130"
                                                          Height="34"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          Visibility="Collapsed">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsAdminOrHrMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <TextBlock Text="{Binding Status}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4A5B6C"
                                                           Visibility="Visible">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsAdminOrHrMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtText, Mode=OneWay}" Width="1.4*" CellStyle="{StaticResource GridCellCenterStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="PayrollRunsTab" Header="{Binding RunsTabLabel}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,10,0" Padding="10,6" Background="#F2F7FD" BorderBrush="#E0EAF6" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0" Foreground="#7A8FA5" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#5B6A7A" VerticalContentAlignment="Center"
                                         Text="{Binding RunSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Search employee no, employee name, or period code" />
                            </Grid>
                        </Border>

                            <ComboBox Grid.Column="1"
                                      Height="40"
                                      ItemsSource="{Binding RunStatusFilters}"
                                      SelectedItem="{Binding SelectedRunStatusFilter}" />

                            <TextBlock Grid.Column="2"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#6A7684"
                                   FontWeight="SemiBold"
                                   Text="{Binding PayrollRuns.Count, StringFormat=Rows: {0}}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="12"
                            Style="{StaticResource CardStyle}"
                            Background="#F9FBFF"
                            Visibility="{Binding IsAdminOrHrMode, Converter={StaticResource BoolToVis}}">
                            <Grid x:Name="RunToolbar">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="330" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Payroll Period" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Border Height="42" Background="White" BorderBrush="#D5E3F5" BorderThickness="1" CornerRadius="9">
                                            <ComboBox Height="40" Padding="10,0" BorderThickness="0" Background="Transparent"
                                                      VerticalContentAlignment="Center"
                                                      ItemsSource="{Binding PayrollPeriodOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedRunPeriodId}" />
                                        </Border>
                                    </StackPanel>

                                    <Button Grid.Column="1" Width="170" Height="42" Margin="10,22,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding GenerateAllRunsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16" Margin="0,0,7,0" />
                                            <TextBlock Text="Generate Payroll" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>

                                    <Border Grid.Column="2" Margin="12,22,0,0" Height="42" Padding="12,0"
                                            Background="#EEF6FF" BorderBrush="#D5E3F5" BorderThickness="1" CornerRadius="9">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="Generate, review totals, select employees, then approve and release."
                                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Expander Grid.Row="1" Margin="0,12,0,0" Header="Create a new payroll period">
                                    <Border Margin="0,8,0,0" Padding="12" Background="White" BorderBrush="#DCE8F5" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="240" />
                                                <ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="155" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="Period Code" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                <TextBox Height="40" VerticalContentAlignment="Center"
                                                         Text="{Binding NewPeriodCode, UpdateSourceTrigger=PropertyChanged}"
                                                         materialDesign:HintAssist.Hint="PP-2026-A22" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                <TextBlock Text="Date From" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                <Border Style="{StaticResource DateFieldBorderStyle}"><DatePicker BorderThickness="0" Padding="8,0" Background="Transparent" Language="en-GB" SelectedDateFormat="Short" SelectedDate="{Binding NewPeriodDateFrom}" /></Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0">
                                                <TextBlock Text="Date To" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                <Border Style="{StaticResource DateFieldBorderStyle}"><DatePicker BorderThickness="0" Padding="8,0" Background="Transparent" Language="en-GB" SelectedDateFormat="Short" SelectedDate="{Binding NewPeriodDateTo}" /></Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="8,0">
                                                <TextBlock Text="Pay Date" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                <Border Style="{StaticResource DateFieldBorderStyle}"><DatePicker BorderThickness="0" Padding="8,0" Background="Transparent" Language="en-GB" SelectedDateFormat="Short" SelectedDate="{Binding NewPeriodPayDate}" /></Border>
                                            </StackPanel>
                                            <Button Grid.Column="4" Width="130" Height="40" Margin="8,22,0,0"
                                                    Style="{StaticResource SoftButtonStyle}" Command="{Binding AddPeriodCommand}">
                                                <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Plus" Width="15" Height="15" Margin="0,0,6,0" /><TextBlock Text="Add Period" /></StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Expander>

                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource PayrollSummaryTileStyle}" Margin="0,0,4,0">
                                        <StackPanel><TextBlock Text="Employees" Foreground="#6A7684" /><TextBlock Text="{Binding VisiblePayrollRunCount}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="Bold" /></StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource PayrollSummaryTileStyle}">
                                        <StackPanel><TextBlock Text="Total Gross" Foreground="#6A7684" /><TextBlock Text="{Binding VisiblePayrollGrossText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" /></StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource PayrollSummaryTileStyle}">
                                        <StackPanel><TextBlock Text="Total Deductions" Foreground="#6A7684" /><TextBlock Text="{Binding VisiblePayrollDeductionsText}" Foreground="#B9831A" FontWeight="Bold" /></StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource PayrollSummaryTileStyle}">
                                        <StackPanel><TextBlock Text="Total Net Pay" Foreground="#6A7684" /><TextBlock Text="{Binding VisiblePayrollNetText}" Foreground="#2E9D5B" FontWeight="Bold" /></StackPanel>
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Width="105" Height="40" Margin="0,0,8,0" Style="{StaticResource SoftButtonStyle}" Command="{Binding ToggleSelectAllRunsCommand}" Content="Select All" />
                                        <Button Width="135" Height="40" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ApproveSelectedRunsCommand}" Content="Approve Selected" />
                                        <Button Width="135" Height="40" Style="{StaticResource SuccessButtonStyle}" Command="{Binding ReleaseSelectedRunsCommand}" Content="Release Selected" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,9" Background="#EEF6FF" BorderBrush="#D5E3F5" BorderThickness="1" CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Selected payroll" Foreground="#6A7684" FontSize="12" /><TextBlock Text="{Binding SelectedRun.EmployeeName, TargetNullValue=Select a row to review}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" /></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Gross" Foreground="#6A7684" FontSize="12" /><TextBlock Text="{Binding SelectedRun.GrossPay, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Deductions" Foreground="#6A7684" FontSize="12" /><TextBlock Text="{Binding SelectedRun.DeductionsTotal, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}" Foreground="#B9831A" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="Net Pay" Foreground="#6A7684" FontSize="12" /><TextBlock Text="{Binding SelectedRun.NetPay, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}" Foreground="#2E9D5B" FontWeight="Bold" /></StackPanel>
                                        <TextBlock Grid.Column="4" Text="{Binding SelectedPayrollRunCountText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="12"
                            Style="{StaticResource CardStyle}"
                            Background="#F9FBFF"
                            Visibility="{Binding IsEmployeeMode, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.75*" />
                                <ColumnDefinition Width="1.25*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Selected Run Breakdown"
                                           Foreground="#5B6A7A"
                                           FontWeight="SemiBold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Basic Pay" Foreground="#6A7684" />
                                        <TextBlock Text="{Binding SelectedRun.BasicPay, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Allowances" Foreground="#6A7684" />
                                        <TextBlock Text="{Binding SelectedRun.Allowances, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Overtime + Other" Foreground="#6A7684" />
                                        <TextBlock Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold">
                                            <Run Text="{Binding SelectedRun.OvertimePay, Mode=OneWay, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}" />
                                            <Run Text=" + " />
                                            <Run Text="{Binding SelectedRun.OtherEarnings, Mode=OneWay, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Generated / Status" Foreground="#6A7684" />
                                        <TextBlock Text="{Binding SelectedRunGeneratedLabel}" Foreground="#4A5B6C" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedRunStatusLabel}" Foreground="#4A5B6C" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Gross Pay" Foreground="#6A7684" />
                                        <TextBlock Text="{Binding SelectedRun.GrossPay, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Deductions" Foreground="#6A7684" />
                                        <TextBlock Text="{Binding SelectedRun.DeductionsTotal, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}"
                                                   Foreground="#B9831A"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Net Pay" Foreground="#6A7684" />
                                        <TextBlock Text="{Binding SelectedRun.NetPay, StringFormat='PHP {0:N2}', TargetNullValue='PHP 0.00'}"
                                                   Foreground="#2E9D5B"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="Report Payroll Concern"
                                           Foreground="#5B6A7A"
                                           FontWeight="SemiBold" />
                                <TextBox Margin="0,8,0,0"
                                         Height="84"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"
                                         IsEnabled="{Binding CanReportPayrollConcern}"
                                         Text="{Binding PayrollConcernDetails, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Describe your payroll concern..." />
                                <Button Margin="0,10,0,0"
                                        Height="40"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding CanReportPayrollConcern}"
                                        Command="{Binding ReportPayrollConcernCommand}"
                                        CommandParameter="{Binding SelectedRun}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MessageAlertOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                        <TextBlock Text="Report Concern" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,12,0,0"
                                    Padding="10,8"
                                    CornerRadius="10"
                                    Background="#F2F7FD"
                                    BorderBrush="#E5EDF7"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding YtdLabel}" Foreground="#5B6A7A" FontWeight="SemiBold" Margin="0,0,14,0" />
                                    <TextBlock Text="Gross:" Foreground="#6A7684" FontWeight="SemiBold" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding YtdGrossPayText}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Margin="0,0,18,0" />
                                    <TextBlock Text="Deductions:" Foreground="#6A7684" FontWeight="SemiBold" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding YtdDeductionsText}" Foreground="#B9831A" FontWeight="Bold" Margin="0,0,18,0" />
                                    <TextBlock Text="Net:" Foreground="#6A7684" FontWeight="SemiBold" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding YtdNetPayText}" Foreground="#2E9D5B" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding PayrollRuns}"
                                  SelectedItem="{Binding SelectedRun}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  RowHeight="56"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FBFF"
                                  HorizontalGridLinesBrush="#E9F0FA"
                                  VerticalGridLinesBrush="#E9F0FA"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="PayrollRunEmployeeColumn" Header="Employee" Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,0">
                                                <TextBlock Text="{Binding EmployeeName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                                <TextBlock FontSize="12" Foreground="#6A7684">
                                                    <Run Text="{Binding EmployeeNo, Mode=OneWay}" />
                                                    <Run Text=" | " />
                                                    <Run Text="{Binding PeriodCode, Mode=OneWay}" />
                                                    <Run Text=" | " />
                                                    <Run Text="{Binding PayrollCycleText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Gross" Binding="{Binding GrossPay, Mode=OneWay, StringFormat=PHP {0:N2}}" Width="1*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Deductions" Binding="{Binding DeductionsTotal, Mode=OneWay, StringFormat=PHP {0:N2}}" Width="1*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Net Pay" Binding="{Binding NetPay, Mode=OneWay, StringFormat=PHP {0:N2}}" Width="1*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTemplateColumn Header="Status" Width="1.25*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="{Binding StatusBrush}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding LastReleasedAtText, Mode=OneWay}" FontSize="11" Foreground="#6A7684" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions"
                                                        Width="155"
                                                        CellStyle="{StaticResource GridActionCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Width="90"
                                                        Margin="0,0,7,0"
                                                        Style="{StaticResource GridPrimaryButtonStyle}"
                                                        Command="{Binding DataContext.SelectRunCommand, Source={x:Reference Root}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="EyeOutline" Width="14" Height="14" Margin="0,0,5,0" />
                                                        <TextBlock Text="View" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GridMoreButtonStyle}"
                                                        Tag="{Binding}"
                                                        ToolTip="More payroll actions"
                                                        Click="PayrollRunActionsButton_OnClick">
                                                    <materialDesign:PackIcon Kind="DotsHorizontal" Width="18" Height="18" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="PayslipReleasesTab" Header="{Binding ReleaseTabLabel}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,10,0" Padding="10,6" Background="#F2F7FD" BorderBrush="#E0EAF6" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,8,0" Foreground="#7A8FA5" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#5B6A7A" VerticalContentAlignment="Center"
                                         Text="{Binding ReleaseSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Search period, employee, remarks, or released by" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="#6A7684"
                                   FontWeight="SemiBold"
                                   Text="{Binding PayslipReleases.Count, StringFormat=Rows: {0}}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding PayslipReleases}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FBFF"
                                  HorizontalGridLinesBrush="#E9F0FA"
                                  VerticalGridLinesBrush="#E9F0FA"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Release ID" Binding="{Binding PayslipReleaseId, Mode=OneWay}" Width="0.8*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTemplateColumn Header="Run ID" Width="0.8*" CellStyle="{StaticResource GridActionCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RunIdButtonStyle}"
                                                    ToolTip="Select payroll run"
                                                    Command="{Binding DataContext.SelectRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding PayrollRunId}" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Period" Binding="{Binding PeriodCode, Mode=OneWay}" Width="1*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn x:Name="PayslipReleaseEmpNoColumn" Header="Emp No" Binding="{Binding EmployeeNo, Mode=OneWay}" Width="0.9*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn x:Name="PayslipReleaseEmployeeColumn" Header="Employee" Binding="{Binding EmployeeName, Mode=OneWay}" Width="1.6*" />
                                <DataGridTextColumn Header="Released At" Binding="{Binding ReleasedAtText, Mode=OneWay}" Width="1.35*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="1*" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Released By" Binding="{Binding ReleasedBy, Mode=OneWay}" Width="1.3*" />
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks, Mode=OneWay}" Width="2*" />
                                <DataGridTemplateColumn Header="Actions"
                                                        Width="230"
                                                        CellStyle="{StaticResource GridActionCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Width="112"
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource GridPrimaryButtonStyle}"
                                                        Command="{Binding DataContext.DownloadPayslipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Download" Width="13" Height="13" Margin="0,0,4,0" />
                                                        <TextBlock Text="Download" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Width="96"
                                                        Style="{StaticResource GridPrimaryButtonStyle}"
                                                        Command="{Binding DataContext.PrintPayslipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Printer" Width="13" Height="13" Margin="0,0,4,0" />
                                                        <TextBlock Text="Print" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding ConcernsTabLabel}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Padding="12"
                            Style="{StaticResource CardStyle}"
                            Background="#F9FBFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="420" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Payroll concern tracking" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Open concerns move to Reviewing before they are Resolved or Rejected. Employees can track the decision here."
                                           TextWrapping="Wrap"
                                           Foreground="#5B6A7A" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Margin="16,0,0,0"
                                     Height="58"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Visibility="{Binding IsAdminOrHrMode, Converter={StaticResource BoolToVis}}"
                                     Text="{Binding ConcernResolutionNotes, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Resolution notes (required when closing)" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding PayrollConcerns}"
                                  SelectedItem="{Binding SelectedPayrollConcern}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeaderWidth="0"
                                  RowHeight="62"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FBFF"
                                  HorizontalGridLinesBrush="#E9F0FA"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select"
                                                        Binding="{Binding IsSelectedForBulk, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Width="58"
                                                        CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Period" Binding="{Binding PeriodCode}" Width="1.1*" />
                                <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="1.5*" />
                                <DataGridTextColumn Header="Concern" Binding="{Binding ConcernDetails}" Width="2.3*" />
                                <DataGridTextColumn Header="Filed" Binding="{Binding CreatedAtText}" Width="1.2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="0.9*" />
                                <DataGridTextColumn Header="Resolution" Binding="{Binding ResolutionNotes}" Width="1.8*" />
                                <DataGridTemplateColumn Header="Admin Actions" Width="286">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Width="82" Margin="0,0,6,0"
                                                        Style="{StaticResource GridPrimaryButtonStyle}"
                                                        IsEnabled="{Binding CanStartReview}"
                                                        Visibility="{Binding DataContext.IsAdminOrHrMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.ReviewPayrollConcernCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Review" />
                                                </Button>
                                                <Button Width="88" Margin="0,0,6,0"
                                                        Style="{StaticResource GridSuccessButtonStyle}"
                                                        IsEnabled="{Binding CanClose}"
                                                        Visibility="{Binding DataContext.IsAdminOrHrMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.ResolvePayrollConcernCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Resolve" />
                                                </Button>
                                                <Button Width="88"
                                                        Style="{StaticResource GridDangerButtonStyle}"
                                                        IsEnabled="{Binding CanClose}"
                                                        Visibility="{Binding DataContext.IsAdminOrHrMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.RejectPayrollConcernCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="Reject" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="DeductionsTab" Header="{Binding DeductionsTabLabel}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,10"
                            Padding="16"
                            Style="{StaticResource CardStyle}"
                            Background="#F9FBFF">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding GovernmentContributionTitle}"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="Bold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Review SSS or GSIS, PhilHealth, Pag-IBIG, tax, DTR, loan, and other payroll deductions."
                                           Foreground="#6A7684" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SoftButtonStyle}"
                                        MinWidth="126"
                                        Margin="0,0,8,0"
                                        Command="{Binding ExportGovernmentReportCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDelimitedOutline" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="Download CSV" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="126"
                                        Command="{Binding SaveGovernmentReportPdfCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="Download PDF" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Payroll Period"
                                               Foreground="#5B6A7A"
                                               FontWeight="SemiBold" />
                                    <Border Margin="0,6,0,0"
                                            Height="40"
                                            Background="White"
                                            BorderBrush="#D5E3F5"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ComboBox Height="38"
                                                  Padding="10,0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding PeriodOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedGovernmentPeriodId}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Employee"
                                               Foreground="#5B6A7A"
                                               FontWeight="SemiBold" />
                                    <Border Margin="0,6,0,0"
                                            Height="40"
                                            Background="White"
                                            BorderBrush="#D5E3F5"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ComboBox Height="38"
                                                  Padding="10,0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding DeductionEmployeeOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding SelectedGovernmentEmployeeId}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Deduction Type"
                                               Foreground="#5B6A7A"
                                               FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="All Deductions"
                                                Style="{StaticResource SoftButtonStyle}"
                                                MinWidth="120"
                                                Margin="0,0,8,0"
                                                Command="{Binding ViewAllDeductionsCommand}" />
                                        <Button Content="SSS"
                                                Style="{StaticResource SoftButtonStyle}"
                                                MinWidth="74"
                                                Margin="0,0,8,0"
                                                Command="{Binding ViewSssCommand}" />
                                        <Button Content="GSIS"
                                                Style="{StaticResource SoftButtonStyle}"
                                                MinWidth="74"
                                                Margin="0,0,8,0"
                                                Command="{Binding ViewGsisCommand}" />
                                        <Button Content="PhilHealth"
                                                Style="{StaticResource SoftButtonStyle}"
                                                MinWidth="104"
                                                Margin="0,0,8,0"
                                                Command="{Binding ViewPhilHealthCommand}" />
                                        <Button Content="Pag-IBIG"
                                                Style="{StaticResource SoftButtonStyle}"
                                                MinWidth="94"
                                                Command="{Binding ViewPagIbigCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Background="#FFF7E8" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding GovernmentReportEmployeeShareLabel}" Foreground="#7B6435" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding GovernmentReportEmployeeShareTotalText}" Margin="0,5,0,0" Foreground="#B7791F" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Background="#EDF5FF" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding GovernmentReportEmployerShareLabel}" Foreground="#526A82" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding GovernmentReportEmployerShareTotalText}" Margin="0,5,0,0" Foreground="{StaticResource PrimaryBrush}" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource CardStyle}" Background="#EAF8F0" Padding="16,12">
                            <StackPanel>
                                <TextBlock Text="{Binding GovernmentReportRemittanceLabel}" Foreground="#4E725E" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding GovernmentReportRemittanceTotalText}" Margin="0,5,0,0" Foreground="#2E9D5B" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding GovernmentContributionRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  RowHeight="48"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8FBFF"
                                  HorizontalGridLinesBrush="#E9F0FA"
                                  VerticalGridLinesBrush="#E9F0FA"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Run" Binding="{Binding PayrollRunId, Mode=OneWay}" Width="70" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Period" Binding="{Binding PeriodCode, Mode=OneWay}" Width="105" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Pay Date" Binding="{Binding PayDateText, Mode=OneWay}" Width="120" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTemplateColumn Header="Employee" Width="1.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,0">
                                                <TextBlock Text="{Binding EmployeeName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                                <TextBlock Text="{Binding EmployeeNo, Mode=OneWay}" FontSize="12" Foreground="#6A7684" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Appointment" Binding="{Binding EmploymentTypeName, Mode=OneWay}" Width="125" />
                                <DataGridTextColumn Header="Deduction" Binding="{Binding DeductionType, Mode=OneWay}" Width="1.25*" />
                                <DataGridTextColumn Header="Minus Time" Binding="{Binding MinusTimeText, Mode=OneWay}" Width="95" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeShare, Mode=OneWay, StringFormat={}{0:N2}}" Width="105" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Employer" Binding="{Binding EmployerShare, Mode=OneWay, StringFormat={}{0:N2}}" Width="105" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalRemittance, Mode=OneWay, StringFormat={}{0:N2}}" Width="105" CellStyle="{StaticResource GridCellCenterStyle}" />
                                <DataGridTextColumn Header="Status" Binding="{Binding RunStatus, Mode=OneWay}" Width="95" CellStyle="{StaticResource GridCellCenterStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3"
                Margin="6,0,6,0"
                Padding="10,7"
                CornerRadius="10"
                BorderBrush="#E5EDF7"
                BorderThickness="1"
                Background="#F2F7FD">
            <TextBlock Text="{Binding ActionMessage}"
                       Foreground="{Binding ActionMessageBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>

