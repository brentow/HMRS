<UserControl x:Class="HRMS.View.UsersRolesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1100"
             Background="White">
    <UserControl.Resources>
        <Color x:Key="PrimaryColor">#1E4368</Color>
        <Color x:Key="AccentColor">#FDBD55</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E5EDF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="ProfileInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#D6E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F9FBFF"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ProfilePrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ProfilePrimaryButtonStyle}">
            <Setter Property="Background" Value="#F0F5FD"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="ProfileDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ProfilePrimaryButtonStyle}">
            <Setter Property="Background" Value="#D84545"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E5EDF7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SettingsInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#D6E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F7FAFF"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingsComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderBrush" Value="#D6E1F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F7FAFF"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AdminSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE7F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="AdminMetricCardStyle" TargetType="Border" BasedOn="{StaticResource AdminSurfaceStyle}">
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="AdminFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526477"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="AdminInputStyle" TargetType="TextBox" BasedOn="{StaticResource SettingsInputStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD8E7"/>
            <Setter Property="Foreground" Value="#24384C"/>
        </Style>

        <Style x:Key="AdminComboStyle" TargetType="ComboBox" BasedOn="{StaticResource SettingsComboStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD8E7"/>
            <Setter Property="Foreground" Value="#24384C"/>
        </Style>

        <Style x:Key="AdminPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ProfilePrimaryButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#285987"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AdminSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AdminPrimaryButtonStyle}">
            <Setter Property="Background" Value="#EDF3FA"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DDE9F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource AdminPrimaryButtonStyle}">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="GridResetButtonStyle" TargetType="Button" BasedOn="{StaticResource AdminSecondaryButtonStyle}">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="GridDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource GridResetButtonStyle}">
            <Setter Property="Background" Value="#FFF0F0"/>
            <Setter Property="Foreground" Value="#C93636"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE1E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4" Background="White">
        <TabControl x:Name="UsersRolesTabControl">
            <TabItem x:Name="ProfileTabItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCircleOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Profile"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Current Login Profile" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Manage your account details and password." Foreground="#5B6A7A" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ProfilePrimaryButtonStyle}"
                                    Width="190"
                                    Margin="0,0,8,0"
                                    Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Back to Dashboard"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ProfileSecondaryButtonStyle}"
                                    Width="110"
                                    Margin="0,0,8,0"
                                    Command="{Binding RefreshCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Reload"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ProfilePrimaryButtonStyle}"
                                    Width="130"
                                    Margin="0,0,8,0"
                                    Command="{Binding SaveProfileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Save Profile"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ProfileDangerButtonStyle}"
                                    Width="110"
                                    Click="LogoutButton_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LogoutVariant" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Log Out"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            BorderBrush="#DDE8F6"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,12"
                            Background="#F7FAFF">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="32" Background="White" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="AccountCircle" Width="36" Height="36" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentFullName}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding CurrentUsername, StringFormat=@{0}}" Foreground="#5B6A7A" FontSize="14" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Background="#EAF2FB" CornerRadius="10" Padding="12,4" Margin="0,0,0,6" MinWidth="120">
                                    <TextBlock Text="{Binding ProfileRole}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Background="{Binding CurrentStatusBrush}" CornerRadius="10" Padding="12,4" MinWidth="120">
                                    <TextBlock Text="{Binding CurrentStatus}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ProfileCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Profile Information" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="Username" Foreground="#4A5B6C" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="40" Background="#EEF4FD" BorderBrush="#D6E1F0" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8">
                                        <materialDesign:PackIcon Kind="At" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource ProfileInputStyle}"
                                             BorderThickness="0,1,1,1"
                                             Text="{Binding ProfileUsername, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <TextBlock Text="Full Name" Foreground="#4A5B6C" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="40" Background="#EEF4FD" BorderBrush="#D6E1F0" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8">
                                        <materialDesign:PackIcon Kind="AccountOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource ProfileInputStyle}"
                                             BorderThickness="0,1,1,1"
                                             Text="{Binding ProfileFullName, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <TextBlock Text="Email" Foreground="#4A5B6C" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="40" Background="#EEF4FD" BorderBrush="#D6E1F0" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8">
                                        <materialDesign:PackIcon Kind="EmailOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource ProfileInputStyle}"
                                             BorderThickness="0,1,1,1"
                                             Text="{Binding ProfileEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ProfileCardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Access &amp; Security" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <Border Background="#F6FAFF" BorderBrush="#E5EDF7" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="User ID" Foreground="#6A7684" FontSize="12"/>
                                            <TextBlock Text="{Binding CurrentUserId}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F6FAFF" BorderBrush="#E5EDF7" BorderThickness="1" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Role" Foreground="#6A7684" FontSize="12"/>
                                            <TextBlock Text="{Binding ProfileRole}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Background="#F6FAFF" BorderBrush="#E5EDF7" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Last Login" Foreground="#6A7684" FontSize="12"/>
                                            <TextBlock Text="{Binding ProfileLastLogin}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{Binding CurrentStatusBrush}" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProfileStatus}" Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock Text="New Password (optional)" Foreground="#4A5B6C" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="40" Background="#EEF4FD" BorderBrush="#D6E1F0" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8">
                                        <materialDesign:PackIcon Kind="LockOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource ProfileInputStyle}"
                                             BorderThickness="0,1,1,1"
                                             Text="{Binding ProfileNewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <TextBlock Text="Confirm Password" Foreground="#4A5B6C" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="40" Background="#EEF4FD" BorderBrush="#D6E1F0" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8">
                                        <materialDesign:PackIcon Kind="LockCheckOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource ProfileInputStyle}"
                                             BorderThickness="0,1,1,1"
                                             Text="{Binding ProfileConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <TextBlock Text="Leave password fields empty if you only want to update profile details."
                                           Foreground="#6A7684"
                                           FontSize="12"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="UsersRolesAdminTabItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountGroupOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Users &amp; Roles Administration"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="18,12,18,14" Background="#F7F9FC">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page heading and primary navigation -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="46"
                                    Height="46"
                                    CornerRadius="10"
                                    Background="#E7F0FA"
                                    Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="AccountGroupOutline"
                                                         Width="24"
                                                         Height="24"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Users &amp; Roles"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Manage user access, roles, account status, and credentials."
                                           Foreground="#657589"
                                           FontSize="13"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Width="176"
                                    Margin="0,0,8,0"
                                    Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Style="{StaticResource AdminSecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Back to Dashboard"/>
                                </StackPanel>
                            </Button>
                            <Button Width="108"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource AdminPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Refresh"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Search and filters -->
                    <Border Grid.Row="1"
                            Style="{StaticResource AdminSurfaceStyle}"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="40"
                                    Margin="0,0,12,0"
                                    Background="#F8FAFD"
                                    BorderBrush="#CBD8E7"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <DockPanel LastChildFill="True">
                                    <materialDesign:PackIcon Kind="Magnify"
                                                             Width="18"
                                                             Height="18"
                                                             Margin="12,0,8,0"
                                                             Foreground="#71849A"
                                                             VerticalAlignment="Center"/>
                                    <TextBox BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             VerticalContentAlignment="Center"
                                             materialDesign:HintAssist.Hint="Search by username, name, email, or role"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </Border>
                            <Grid Grid.Column="1">
                                <materialDesign:PackIcon Kind="FilterOutline"
                                                         Width="17"
                                                         Height="17"
                                                         Margin="11,0,0,0"
                                                         Foreground="#71849A"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Panel.ZIndex="1"/>
                                <ComboBox Height="40"
                                          Padding="34,0,10,0"
                                          Style="{StaticResource AdminComboStyle}"
                                          ItemsSource="{Binding StatusFilters}"
                                          SelectedItem="{Binding SelectedStatusFilter}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Account summary -->
                    <UniformGrid Grid.Row="2" Columns="6" Rows="1" Margin="0,0,0,12">
                        <Border Style="{StaticResource AdminMetricCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="TOTAL USERS" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalUsers}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0"/></StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="AccountGroupOutline" Width="22" Height="22" Foreground="#7592B0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AdminMetricCardStyle}" Background="#F3FAF6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="ACTIVE" Foreground="#5C7A69" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveUsers}" FontSize="24" FontWeight="Bold" Foreground="#2E9D5B" Margin="0,2,0,0"/></StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="AccountCheckOutline" Width="22" Height="22" Foreground="#4BA36C" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AdminMetricCardStyle}" Background="#FAFBFC">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="INACTIVE" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding InactiveUsers}" FontSize="24" FontWeight="Bold" Foreground="#7D8793" Margin="0,2,0,0"/></StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="AccountOffOutline" Width="22" Height="22" Foreground="#8A96A3" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AdminMetricCardStyle}" Background="#FFF6F6">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="LOCKED" Foreground="#8A6565" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding LockedUsers}" FontSize="24" FontWeight="Bold" Foreground="#D84343" Margin="0,2,0,0"/></StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="LockOutline" Width="22" Height="22" Foreground="#D65B5B" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AdminMetricCardStyle}" Background="#FFF8EB">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="ADMINS" Foreground="#896B37" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding AdminUsers}" FontSize="24" FontWeight="Bold" Foreground="#E9A536" Margin="0,2,0,0"/></StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="ShieldAccountOutline" Width="22" Height="22" Foreground="#E5A43B" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource AdminMetricCardStyle}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="ACCESS MODEL" Foreground="#718096" FontSize="11" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding TotalRoles, StringFormat={}{0} roles}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/><TextBlock Text="  •  " Foreground="#A0ADBA"/><TextBlock Text="{Binding TotalPermissions, StringFormat={}{0} permissions}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></StackPanel>
                                <materialDesign:PackIcon Grid.Column="1" Kind="KeyOutline" Width="22" Height="22" Foreground="#7592B0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Create account form -->
                    <Border Grid.Row="3"
                            Style="{StaticResource AdminSurfaceStyle}"
                            Padding="15,13"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Create user account" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="Enter the employee's identity, access role, and temporary password." FontSize="12" Foreground="#718096" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Width="126"
                                        Command="{Binding AddUserCommand}"
                                        Style="{StaticResource AdminPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountPlusOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Add User"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <UniformGrid Grid.Row="1" Columns="6" Rows="1" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,7,0">
                                    <TextBlock Text="Username" Style="{StaticResource AdminFieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource AdminInputStyle}" Text="{Binding AddUserUsername, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="7,0">
                                    <TextBlock Text="Full Name" Style="{StaticResource AdminFieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource AdminInputStyle}" Text="{Binding AddUserFullName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="7,0">
                                    <TextBlock Text="Email Address" Style="{StaticResource AdminFieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource AdminInputStyle}" Text="{Binding AddUserEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="7,0">
                                    <TextBlock Text="Role" Style="{StaticResource AdminFieldLabelStyle}"/>
                                    <ComboBox Style="{StaticResource AdminComboStyle}" ItemsSource="{Binding AddUserRoles}" SelectedItem="{Binding AddUserRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="7,0">
                                    <TextBlock Text="Temporary Password" Style="{StaticResource AdminFieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource AdminInputStyle}" Text="{Binding AddUserPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Margin="7,0,0,0">
                                    <TextBlock Text="Confirm Password" Style="{StaticResource AdminFieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource AdminInputStyle}" Text="{Binding AddUserConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- User directory -->
                    <Border Grid.Row="4"
                            Style="{StaticResource AdminSurfaceStyle}"
                            ClipToBounds="True">
                        <DataGrid AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E6EDF5"
                                  VerticalGridLinesBrush="Transparent"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  RowHeight="50"
                                  ColumnHeaderHeight="42"
                                  AlternationCount="2"
                                  AlternatingRowBackground="#FAFBFD"
                                  Background="White"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  ItemsSource="{Binding Users}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EDF3FA"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="BorderBrush" Value="#DDE7F2"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="#263A4E"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="#263A4E"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F6FC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E4EFFA"/>
                                            <Setter Property="Foreground" Value="#183A5B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="0.8*" MinWidth="105"/>
                                <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="1.25*" MinWidth="160"/>
                                <DataGridTextColumn Header="Email Address" Binding="{Binding Email}" Width="1.55*" MinWidth="185"/>
                                <DataGridTemplateColumn Header="Role" Width="0.9*" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Height="34"
                                                      Margin="0,4"
                                                      Style="{StaticResource AdminComboStyle}"
                                                      ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding SelectedRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="0.85*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Height="34"
                                                      Margin="0,4"
                                                      Style="{StaticResource AdminComboStyle}"
                                                      ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginText}" Width="1.1*" MinWidth="150"/>
                                <DataGridTemplateColumn Header="Actions" Width="1.55*" MinWidth="252">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Style="{StaticResource GridSaveButtonStyle}"
                                                        Margin="0,0,7,0"
                                                        Command="{Binding DataContext.SaveUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" Margin="0,0,4,0"/><TextBlock Text="Save"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GridResetButtonStyle}"
                                                        Margin="0,0,7,0"
                                                        Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="LockReset" Width="14" Height="14" Margin="0,0,4,0"/><TextBlock Text="Reset"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GridDeleteButtonStyle}"
                                                        Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Margin="0,0,4,0"/><TextBlock Text="Delete"/></StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="5"
                            BorderBrush="#DDE7F2"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="11,7"
                            Background="White"
                            Margin="0,10,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="15" Height="15" Foreground="{Binding ActionMessageBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ActionMessage}" Foreground="{Binding ActionMessageBrush}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Users.Count, StringFormat=Visible users: {0}}" Foreground="#657589" FontSize="12"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="SystemSettingsTabItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="System Settings"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System Settings" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Manage database, company profile, storage, backups, and maintenance tools." Foreground="#5B6A7A"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="190"
                                    Height="36"
                                    Style="{StaticResource ProfilePrimaryButtonStyle}"
                                    Command="{Binding DataContext.ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Back to Dashboard"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="DatabaseCogOutline" Width="22" Height="22" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Database Connection" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding DatabaseEndpointText}" Foreground="#5B6A7A"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton Content="Local Database (localhost)"
                                                 IsChecked="{Binding UseLocalDatabase, Mode=TwoWay}"
                                                 Margin="0,0,20,0"/>
                                    <RadioButton Content="Online Database (Hostinger)"
                                                 IsChecked="{Binding UseHostingerDatabase, Mode=TwoWay}"
                                                 Margin="0,0,20,0"/>
                                    <RadioButton Content="Remote Database (Custom IP)"
                                                 IsChecked="{Binding UseRemoteDatabase, Mode=TwoWay}"/>
                                </StackPanel>

                                <Border Background="#EAF4FF" BorderBrush="#D6E8FF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DatabaseModeHint}" Foreground="#2D5783"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Server IP / Host" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0">
                                        <TextBlock Text="Port" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                        <TextBlock Text="Database Name" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding DbName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Username" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding DbUsername, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Password" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding DbPassword, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Width="150"
                                            Height="40"
                                            Margin="0,0,8,0"
                                            Command="{Binding TestDbConnectionCommand}"
                                            Style="{StaticResource ProfileSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseSearchOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Test Connection"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="165"
                                            Height="40"
                                            Margin="0,0,8,0"
                                            Command="{Binding CreateDatabaseCommand}"
                                            Style="{StaticResource ProfileSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabasePlusOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Create Database"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="150"
                                            Height="40"
                                            Command="{Binding SaveDbConnectionCommand}"
                                            Style="{StaticResource ProfilePrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Save &amp; Apply"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Width="190"
                                            Height="40"
                                            Margin="8,0,0,0"
                                            Command="{Binding ImportBeneficiariesCommand}"
                                            Style="{StaticResource ProfileSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseImportOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Import Beneficiaries"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding DbConnectionStatus}"
                                               Foreground="{Binding DbConnectionStatusBrush}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Reads from CRS val_beneficiaries in batches and inserts only into BeneficiaryStaging as Pending."
                                           Foreground="#5B6A7A"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="Domain" Width="22" Height="22" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel>
                                        <TextBlock Text="System Identity" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="Configure the company name, address, owner, serial number, and logo path used by Login and Dashboard." Foreground="#5B6A7A" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Company Name" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding SystemCompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Address" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding SystemCompanyAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Owner / Signatory" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding SystemCompanyOwner, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Serial Number" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SettingsInputStyle}" Text="{Binding SystemSerialNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Logo Path (default: HRMS/Images/ePRIME_logo.png)" Foreground="#5B6A7A" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource SettingsInputStyle}"
                                             Text="{Binding SystemLogoPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1"
                                            Width="160"
                                            Height="40"
                                            Margin="10,0,0,0"
                                            Command="{Binding ChooseSystemLogoCommand}"
                                            Style="{StaticResource ProfileSecondaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderImage" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Choose Logo"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Choose a picture to replace the logo. HRMS will copy it into local branding storage for this installation."
                                           Foreground="#5B6A7A"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Width="170"
                                            Height="40"
                                            Command="{Binding SaveCompanyProfileCommand}"
                                            Style="{StaticResource ProfilePrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Save Identity"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="22" Height="22" Foreground="#2D8CFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="About" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="System Version:" Foreground="#5B6A7A" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Column="1" Text="Version 1.0.0 - HRMS Desktop (DSSC Release)" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Text="Developer:" Foreground="#5B6A7A" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="IT Student Final Project - DSSC" Foreground="#2A3C50" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="2" Text="University:" Foreground="#5B6A7A" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Davao del Sur State College (DSSC)" Foreground="#2A3C50" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="3" Text="Description:" Foreground="#5B6A7A"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Desktop WPF Human Resource Management System using MySQL and online Hostinger database." Foreground="#2A3C50"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="ServerNetwork" Width="22" Height="22" Foreground="#3BAF63" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="System Information" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DbConnectionStatus, StringFormat=Database Status: {0}}" Foreground="{Binding DbConnectionStatusBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding StorageLocation, StringFormat=File Storage Location: {0}}" Foreground="#2A3C50" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TempFolderPath, StringFormat=Temp Folder: {0}}" Foreground="#2A3C50" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Button Width="150" Height="40" Margin="0,0,0,8" Command="{Binding RefreshSystemInfoCommand}" Style="{StaticResource ProfileSecondaryButtonStyle}">
                                        <TextBlock Text="Test Connection"/>
                                    </Button>
                                    <Button Width="150" Height="40" Margin="0,0,0,8" Command="{Binding ChooseStorageFolderCommand}" Style="{StaticResource ProfileSecondaryButtonStyle}">
                                        <TextBlock Text="Choose Folder"/>
                                    </Button>
                                    <Button Width="150" Height="40" Command="{Binding OpenStorageFolderCommand}" Style="{StaticResource ProfileSecondaryButtonStyle}">
                                        <TextBlock Text="Open Folder"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="DatabaseExportOutline" Width="22" Height="22" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Database Backup" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Create full, differential, and incremental backups of the currently configured HRMS database. Restore can rebuild a selected backup chain back into the same database." Foreground="#5B6A7A" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Border Background="#EFF7FF" BorderBrush="#CEE2F7" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LastFullBackupText, StringFormat=Last Full Backup: {0}}" Foreground="#2D5783" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding LastDifferentialBackupText, StringFormat=Last Differential Backup: {0}}" Foreground="#41576D" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding LastIncrementalBackupText, StringFormat=Last Incremental Backup: {0}}" Foreground="#41576D" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Backup Type" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="#EDF5FF"
                                            BorderBrush="#BCD9FF"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14">
                                        <Grid MinHeight="214">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="Database" Width="18" Height="18" Foreground="#2D5783" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Full Backup" FontSize="15" FontWeight="Bold" Foreground="#234D7A" VerticalAlignment="Center"/>
                                                <Border Background="#D8EAFE" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Recommended" FontSize="11" FontWeight="SemiBold" Foreground="#234D7A"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="Copies the whole configured HRMS database." Foreground="#41576D" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="Creates a complete snapshot of every HRMS table. Required before differential or incremental backups can run." TextWrapping="Wrap" Foreground="#5B6A7A" FontSize="12"/>
                                            <Button Width="150"
                                                    Grid.Row="4"
                                                    Height="38"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Left"
                                                    Background="#1E4368"
                                                    Foreground="White"
                                                    Command="{Binding CreateBackupCommand}"
                                                    Style="{StaticResource ProfilePrimaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DatabaseArrowDownOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Full Backup"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="#F6F8FC"
                                            BorderBrush="#D9E1EC"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14">
                                        <Grid MinHeight="214">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="DatabaseRefreshOutline" Width="18" Height="18" Foreground="#50657B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Incremental Backup" FontSize="15" FontWeight="Bold" Foreground="#2A3C50" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="Copies only the new changes after the most recent backup." Foreground="#41576D" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="Creates a compact delta from the most recent backup in the chain. Best when you back up often and want smaller files." TextWrapping="Wrap" Foreground="#5B6A7A" FontSize="12"/>
                                            <Button Width="180"
                                                    Grid.Row="4"
                                                    Height="38"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Left"
                                                    Background="#4E647B"
                                                    Foreground="White"
                                                    Command="{Binding CreateIncrementalBackupCommand}"
                                                    Style="{StaticResource ProfileSecondaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DatabaseRefreshOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Incremental Backup"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="4"
                                            Background="#FFF8EC"
                                            BorderBrush="#F5DEB3"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14">
                                        <Grid MinHeight="214">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="DatabaseSyncOutline" Width="18" Height="18" Foreground="#9C6B00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Differential Backup" FontSize="15" FontWeight="Bold" Foreground="#7D5A00" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="Copies all changes made since the last full backup." Foreground="#7A6333" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="Captures all changes since the latest full backup. Larger than incremental, but simpler to restore because it only needs the matching full backup." TextWrapping="Wrap" Foreground="#8A7342" FontSize="12"/>
                                            <Button Width="175"
                                                    Grid.Row="4"
                                                    Height="38"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Left"
                                                    Background="#C48213"
                                                    Foreground="White"
                                                    Command="{Binding CreateDifferentialBackupCommand}"
                                                    Style="{StaticResource ProfileSecondaryButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="DatabaseSyncOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Differential Backup"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Border Background="#FBFDFF"
                                        BorderBrush="#E2EAF5"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Saved Backups"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="{Binding BackupCatalog.Count, StringFormat=Stored backup files: {0}}"
                                                           Foreground="#5B6A7A"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Width="150"
                                                        Height="38"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding RestoreBackupCommand}"
                                                        IsEnabled="{Binding HasSelectedBackup}"
                                                        Style="{StaticResource ProfilePrimaryButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="DatabaseImportOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Use Selected"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Width="140"
                                                        Height="38"
                                                        Margin="0,0,8,0"
                                                        Command="{Binding ClearBackupSelectionCommand}"
                                                        IsEnabled="{Binding HasSelectedBackup}"
                                                        Style="{StaticResource ProfileSecondaryButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="SelectionOff" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Clear Selection"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Width="140"
                                                        Height="38"
                                                        Command="{Binding DeleteBackupCommand}"
                                                        IsEnabled="{Binding HasSelectedBackup}"
                                                        Style="{StaticResource ProfileDangerButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Delete Selected"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Select a saved backup below to restore its chain into HRMS or remove it from storage."
                                                   Foreground="#5B6A7A"
                                                   Margin="0,0,0,8"
                                                   TextWrapping="Wrap"/>

                                        <DataGrid AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserResizeRows="False"
                                                  GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column"
                                                  RowHeaderWidth="0"
                                                  BorderThickness="1"
                                                  BorderBrush="#E5EDF7"
                                                  IsReadOnly="True"
                                                  Height="280"
                                                  ItemsSource="{Binding BackupCatalog}"
                                                  SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                                                  SelectionMode="Single"
                                                  SelectionUnit="FullRow">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#F2F6FC"/>
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="10,8"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtText}" Width="170"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding BackupTypeLabel}" Width="110"/>
                                                <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="160"/>
                                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*"/>
                                                <DataGridTextColumn Header="Chain" Binding="{Binding ChainText}" Width="210"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Width="180"
                                            Height="40"
                                            Margin="0,0,8,0"
                                            Command="{Binding RestoreBackupCommand}"
                                            CommandParameter="browse"
                                            Style="{StaticResource ProfilePrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Browse Backup File"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Browse ignores the table selection and lets you pick any JSON backup file manually. Use Selected restores the highlighted backup row."
                                               Foreground="#7A6333"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CloudSyncOutline" Width="22" Height="22" Foreground="#2E8BCE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Sync Live to Local" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Mirror the current live Hostinger HRMS, GGMS, and CRS data into your localhost offline databases so Local mode keeps working when the internet is unavailable."
                                           Foreground="#5B6A7A"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap"/>
                                <Border Background="#EEF7FF" BorderBrush="#CFE5FF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="This sync updates localhost only:" FontWeight="SemiBold" Foreground="#2D5783"/>
                                        <TextBlock Text="- HRMS records, payroll, attendance, leave, documents, and company profile" Foreground="#2D5783" Margin="0,4,0,0"/>
                                        <TextBlock Text="- GGMS allocation snapshot for offline payroll reference" Foreground="#2D5783"/>
                                        <TextBlock Text="- CRS beneficiary data for offline beneficiary access" Foreground="#2D5783"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="180"
                                            Height="40"
                                            Margin="0,0,8,0"
                                            Command="{Binding SyncLiveToLocalCommand}"
                                            Style="{StaticResource ProfilePrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CloudSyncOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Sync Live to Local"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="This does not switch the current connection automatically. Use the Local preset after sync when you want the offline snapshot."
                                               Foreground="#5B6A7A"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="DeleteClockOutline" Width="22" Height="22" Foreground="#B142CF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Clear Temporary Files" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Remove temporary files to free disk space. Files currently in use are skipped." Foreground="#5B6A7A" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding TempFilesSizeText, StringFormat=Current Temp Files Size: {0}}" Foreground="#2A3C50" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <Button Width="180"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ClearTempFilesCommand}"
                                        Style="{StaticResource ProfilePrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Broom" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Clear Temp Files"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="DatabasePlusOutline" Width="22" Height="22" Foreground="#20B8CE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Database Seeder" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Populate database with required baseline/demo data for HRMS modules." Foreground="#5B6A7A" Margin="0,0,0,10"/>
                                <Border Background="#EAF8FF" BorderBrush="#CBEFFF" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Sample data includes:" FontWeight="SemiBold" Foreground="#2D5783"/>
                                        <TextBlock Text="- Roles, permissions, departments, and positions" Foreground="#2D5783" Margin="0,4,0,0"/>
                                        <TextBlock Text="- Employees, user accounts, attendance, DTR, leave, payroll, training" Foreground="#2D5783"/>
                                        <TextBlock Text="- Recruitment and performance sample records" Foreground="#2D5783"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Width="140" Height="40" Margin="0,0,8,0" Command="{Binding SeedDatabaseCommand}" Style="{StaticResource ProfileSecondaryButtonStyle}">
                                        <TextBlock Text="Seed Database"/>
                                    </Button>
                                    <Button Width="150" Height="40" Command="{Binding ResetAndSeedCommand}" Background="#D84343" Foreground="White" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="Reset and Seed"/>
                                    </Button>
                                </StackPanel>
                                <CheckBox Content="I understand this will delete all existing database data"
                                          IsChecked="{Binding ConfirmResetAndSeed, Mode=TwoWay}"
                                          Foreground="#C52F2F"
                                          FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#E5EDF7" BorderThickness="1" CornerRadius="10" Padding="10,6" Background="#F9FBFF">
                            <TextBlock Text="{Binding ActionMessage}"
                                       Foreground="{Binding ActionMessageBrush}"
                                       FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
